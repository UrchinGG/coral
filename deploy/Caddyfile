{
    auto_https off
}

(coral-api) {
    reverse_proxy {
        dynamic a {
            name coral-api
            port 3080
            refresh 2s
        }
        lb_policy round_robin
        health_uri /health
        health_interval 1s
        health_timeout 2s
        health_passes 1
        health_fails 2
        fail_duration 10s
    }
}

(site) {
    encode zstd gzip
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"
    try_files {path}.html {path} {path}/index.html
    file_server
}

(urchin) {
    @account path /auth/* /me/*
    handle @account {
        import coral-api
    }
    handle {
        root * {args[0]}
        import site
    }
}

(starfish) {
    @backend path /api/* /auth/*
    handle @backend {
        import coral-api
    }
    handle {
        root * {args[0]}
        import site
    }
}

:8080 {
    @site_only {
        path /auth/* /me/* /api/*
        not path /api/v1/starfish/*
    }
    respond @site_only 404
    import coral-api
}

http://urchin.gg {
    import urchin /srv/web/live/urchin
}

http://starfish.urchin.gg {
    import starfish /srv/web/live/starfish
}

http://starfish.hexze.dev {
    redir https://starfish.urchin.gg{uri} permanent
}

http://*.urchin.gg {
    @urchin header_regexp urchin Host ^pr-(\d+)\.urchin\.gg$
    @starfish header_regexp starfish Host ^pr-(\d+)-starfish\.urchin\.gg$
    header X-Robots-Tag noindex

    handle @urchin {
        import urchin /srv/web/previews/pr-{re.urchin.1}/urchin
    }
    handle @starfish {
        import starfish /srv/web/previews/pr-{re.starfish.1}/starfish
    }
    respond 404
}
