{
    auto_https off
}

(site) {
    encode zstd gzip
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"
    try_files {path}.html {path} {path}/index.html
    file_server
}

:8080 {
    reverse_proxy {
        dynamic a {
            name coral-api
            port 3080
            refresh 2s
        }
        lb_policy round_robin
        health_uri /health
        health_interval 1s
        health_timeout 2s
        health_passes 1
        health_fails 2
        fail_duration 10s
    }
}

http://urchin.gg {
    root * /srv/web/live/urchin
    import site
}

http://starfish.urchin.gg {
    root * /srv/web/live/starfish
    import site
}

http://*.urchin.gg {
    @urchin header_regexp urchin Host ^pr-(\d+)\.urchin\.gg$
    @starfish header_regexp starfish Host ^pr-(\d+)-starfish\.urchin\.gg$
    header X-Robots-Tag noindex

    handle @urchin {
        root * /srv/web/previews/pr-{re.urchin.1}/urchin
        import site
    }
    handle @starfish {
        root * /srv/web/previews/pr-{re.starfish.1}/starfish
        import site
    }
    respond 404
}
