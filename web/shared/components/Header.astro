---
import { STARFISH_URL, URCHIN_URL } from "astro:env/server";
import { DISCORD_URL, pagePath } from "@shared/links";
import Discord from "./Discord.astro";
import SignIn from "./SignIn.astro";

type Site = "urchin" | "starfish";

interface Props {
  site: Site;
}

const { site } = Astro.props;
const pathname = pagePath(Astro.url);
const origins = { urchin: URCHIN_URL, starfish: STARFISH_URL };
const names = { urchin: "Urchin", starfish: "Starfish" };
const at = (target: Site, path: string) =>
  target === site ? path : new URL(path, origins[target]).href;
const current = (target: Site, path: string) =>
  target === site &&
  (pathname === path || (path !== "/" && pathname.startsWith(`${path}/`)))
    ? "page"
    : undefined;

const icons = {
  home: "M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z",
  replays: "M8,5.14V19.14L19,12.14L8,5.14Z",
  api: "M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z",
  docs: "M12 21.5C10.65 20.65 8.2 20 6.5 20C4.85 20 3.15 20.3 1.75 21.05C1.65 21.1 1.6 21.1 1.5 21.1C1.25 21.1 1 20.85 1 20.6V6C1.6 5.55 2.25 5.25 3 5C4.11 4.65 5.33 4.5 6.5 4.5C8.45 4.5 10.55 4.9 12 6C13.45 4.9 15.55 4.5 17.5 4.5C18.67 4.5 19.89 4.65 21 5C21.75 5.25 22.4 5.55 23 6V20.6C23 20.85 22.75 21.1 22.5 21.1C22.4 21.1 22.35 21.1 22.25 21.05C20.85 20.3 19.15 20 17.5 20C15.8 20 13.35 20.65 12 21.5M12 8V19.5C13.35 18.65 15.8 18 17.5 18C18.7 18 19.9 18.15 21 18.5V7C19.9 6.65 18.7 6.5 17.5 6.5C15.8 6.5 13.35 7.15 12 8Z",
  notes:
    "M14,17H7V15H14M17,13H7V11H17M17,9H7V7H17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z",
};

const sections = [
  {
    site: "urchin",
    name: "Urchin",
    pages: [
      ["Home", "/", icons.home],
      ["Replays", "/replays", icons.replays],
      ["API", "/docs", icons.api],
    ],
  },
  {
    site: "starfish",
    name: "Starfish",
    pages: [
      ["Home", "/", icons.home],
      ["Docs", "/docs", icons.docs],
      ["Patch Notes", "/patch-notes", icons.notes],
    ],
  },
] as const;
---

<header>
  <div class="bar">
    <button
      class="toggle"
      type="button"
      aria-label="Menu"
      popovertarget="site-menu"
    >
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path d="M2 4h12"></path>
        <path d="M2 8h12"></path>
        <path d="M2 12h12"></path>
      </svg>
    </button>
    <a class="brand" href="/">
      <img src={`/brand/${site}.svg`} alt="" width="22" height="22" />
      <span class="name">{names[site]}</span>
    </a>
    {Astro.slots.has("default") && (
      <div class="page">
        <slot />
      </div>
    )}
    {site === "urchin" && <SignIn />}
  </div>
</header>

<div id="site-menu" class="drawer" popover>
  {sections.map(({ site, name, pages }) => (
    <nav aria-label={name}>
      {site === "starfish" && (
        <h2 class="brand">
          <img src="/brand/starfish.svg" alt="" width="22" height="22" />
          {name}
        </h2>
      )}
      <ul role="list">
        {pages.map(([label, path, icon]) => (
          <li>
            <a href={at(site, path)} aria-current={current(site, path)}>
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path d={icon} />
              </svg>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ))}
  <a class="discord" href={DISCORD_URL}>
    <Discord />
    Join the Discord
  </a>
</div>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-background) 80%, transparent);
    font-size: var(--text-base);
    backdrop-filter: blur(24px);
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
    height: var(--nav-height);
    padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px))
      var(--gutter);
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);

    & svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.5;
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
        color: var(--color-text);
      }
    }
  }

  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .page {
    flex: 1;
    min-width: 0;
    margin-left: 0.75rem;
  }

  .toggle path {
    transform-origin: 8px 8px;
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 220ms ease;
  }

  header:has(+ .drawer:popover-open) .toggle {
    color: var(--color-text);

    & path:nth-child(1) {
      transform: rotate(45deg) translateY(4px);
    }

    & path:nth-child(2) {
      opacity: 0;
    }

    & path:nth-child(3) {
      transform: rotate(-45deg) translateY(-4px);
    }
  }

  .drawer {
    --top: calc(var(--nav-height) + 1px);
    inset: var(--top) auto 0 0;
    flex-direction: column;
    gap: 1.75rem;
    width: min(17.5rem, 85vw);
    height: auto;
    margin: 0;
    padding: 0.75rem var(--gutter) max(1rem, env(safe-area-inset-bottom, 0px))
      max(var(--gutter), env(safe-area-inset-left, 0px));
    border: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-base);
    translate: -100% 0;
    transition:
      translate 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;

    &:popover-open {
      display: flex;
      translate: 0;

      @starting-style {
        translate: -100% 0;
      }
    }

    &::backdrop {
      top: var(--top);
      background: var(--color-scrim);
      opacity: 0;
      transition:
        opacity 220ms ease,
        display 220ms allow-discrete,
        overlay 220ms allow-discrete;
    }

    &:popover-open::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop,
    .toggle path {
      transition: none;
    }
  }

  .drawer h2 {
    margin-bottom: 0.5rem;
  }

  ul {
    display: grid;
    gap: 0.125rem;
  }

  ul a {
    display: flex;
    align-items: center;
    gap: 0.8125rem;
    margin-left: -0.5rem;
    padding: 0.5rem 0.75rem 0.5rem 0.6875rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--transition),
      color var(--transition);

    & svg {
      flex: none;
      color: var(--color-text-faint);
      transition: color var(--transition);
    }

    & path {
      fill: currentColor;
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
        color: var(--color-text);

        & svg {
          color: var(--color-text-secondary);
        }
      }
    }

    &[aria-current] {
      background: var(--color-surface-raised-hover);
      color: var(--color-text);

      & svg {
        color: var(--color-text);
      }
    }
  }

  .discord {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin-top: auto;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-discord);
    color: white;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background-color var(--transition);

    @media (hover: hover) {
      &:hover {
        background: color-mix(in srgb, var(--color-discord) 85%, black);
      }
    }
  }

  @media (width < 40rem) {
    header .bar:has(.page) .name {
      display: none;
    }

    .page {
      margin-left: 0;
    }
  }
</style>
