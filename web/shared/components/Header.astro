---
import { STARFISH_URL, URCHIN_URL } from "astro:env/server";
import { DISCORD_URL, pagePath } from "@shared/links";
import Discord from "./Discord.astro";
import SignIn from "./SignIn.astro";

type Site = "urchin" | "starfish";

interface Props {
  site: Site;
}

const { site } = Astro.props;
const pathname = pagePath(Astro.url);
const origins = { urchin: URCHIN_URL, starfish: STARFISH_URL };
const at = (target: Site, path: string) =>
  target === site ? path : new URL(path, origins[target]).href;
const current = (target: Site, path: string) =>
  target === site &&
  (pathname === path || (path !== "/" && pathname.startsWith(`${path}/`)))
    ? "page"
    : undefined;

const icons = {
  home: "M2.5 7.2 8 2.75l5.5 4.45v6.3h-3.75V9.75h-3.5v3.75H2.5z",
  replays: "M4.5 3.2v9.6L12.5 8z",
  api: "M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5",
  overview:
    "M2.75 2.75h4v4h-4zM9.25 2.75h4v4h-4zM2.75 9.25h4v4h-4zM9.25 9.25h4v4h-4z",
  docs: "M2.5 3.5h3.8c1 0 1.7.7 1.7 1.7v8.3c0-.8-.7-1.5-1.5-1.5h-4zM13.5 3.5H9.7c-1 0-1.7.7-1.7 1.7v8.3c0-.8.7-1.5 1.5-1.5h4z",
  notes: "M6 4h7.5M6 8h7.5M6 12h7.5M2.75 4h.5M2.75 8h.5M2.75 12h.5",
};

const sections = [
  {
    site: "urchin",
    name: "Urchin",
    pages: [
      ["Home", "/", icons.home],
      ["Replays", "/replays", icons.replays],
      ["API", "/docs", icons.api],
    ],
  },
  {
    site: "starfish",
    name: "Starfish",
    pages: [
      ["Overview", "/", icons.overview],
      ["Docs", "/docs", icons.docs],
      ["Patch Notes", "/patch-notes", icons.notes],
    ],
  },
] as const;
---

<header>
  <div class="bar">
    <button
      class="toggle"
      type="button"
      aria-label="Menu"
      popovertarget="site-menu"
    >
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path d="M2 4h12"></path>
        <path d="M2 8h12"></path>
        <path d="M2 12h12"></path>
      </svg>
    </button>
    <a class="brand" href={at("urchin", "/")}>
      <img src="/brand/urchin.svg" alt="" width="22" height="22" />
      <span class="name">Urchin</span>
    </a>
    {Astro.slots.has("default") && (
      <div class="page">
        <slot />
      </div>
    )}
    <SignIn />
  </div>
</header>

<div id="site-menu" class="drawer" popover>
  {sections.map(({ site, name, pages }) => (
    <nav aria-label={name}>
      {site === "starfish" && (
        <h2 class="brand">
          <img src="/brand/starfish.svg" alt="" width="22" height="22" />
          {name}
        </h2>
      )}
      <ul role="list">
        {pages.map(([label, path, icon]) => (
          <li>
            <a href={at(site, path)} aria-current={current(site, path)}>
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path d={icon} />
              </svg>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ))}
  <a class="discord" href={DISCORD_URL}>
    <Discord />
    Join the Discord
  </a>
</div>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-background) 80%, transparent);
    font-size: var(--text-base);
    backdrop-filter: blur(24px);
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
    height: var(--nav-height);
    padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px))
      var(--gutter);
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);

    & svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.5;
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
        color: var(--color-text);
      }
    }
  }

  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .page {
    flex: 1;
    min-width: 0;
    margin-left: 0.75rem;
  }

  .toggle path {
    transform-origin: 8px 8px;
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 220ms ease;
  }

  header:has(+ .drawer:popover-open) .toggle {
    color: var(--color-text);

    & path:nth-child(1) {
      transform: rotate(45deg) translateY(4px);
    }

    & path:nth-child(2) {
      opacity: 0;
    }

    & path:nth-child(3) {
      transform: rotate(-45deg) translateY(-4px);
    }
  }

  .drawer {
    --top: calc(var(--nav-height) + 1px);
    inset: var(--top) auto 0 0;
    flex-direction: column;
    gap: 1.75rem;
    width: min(17.5rem, 85vw);
    height: auto;
    margin: 0;
    padding: 0.75rem var(--gutter) max(1rem, env(safe-area-inset-bottom, 0px))
      max(var(--gutter), env(safe-area-inset-left, 0px));
    border: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-base);
    translate: -100% 0;
    transition:
      translate 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;

    &:popover-open {
      display: flex;
      translate: 0;

      @starting-style {
        translate: -100% 0;
      }
    }

    &::backdrop {
      top: var(--top);
      background: var(--color-scrim);
      opacity: 0;
      transition:
        opacity 220ms ease,
        display 220ms allow-discrete,
        overlay 220ms allow-discrete;
    }

    &:popover-open::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop,
    .toggle path {
      transition: none;
    }
  }

  .drawer h2 {
    margin-bottom: 0.5rem;
  }

  ul {
    display: grid;
    gap: 0.125rem;
  }

  ul a {
    display: flex;
    align-items: center;
    gap: 0.8125rem;
    margin-left: -0.5rem;
    padding: 0.5rem 0.75rem 0.5rem 0.6875rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--transition),
      color var(--transition);

    & svg {
      flex: none;
      color: var(--color-text-faint);
      transition: color var(--transition);
    }

    & path {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.4;
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
        color: var(--color-text);

        & svg {
          color: var(--color-text-secondary);
        }
      }
    }

    &[aria-current] {
      background: var(--color-surface-raised-hover);
      color: var(--color-text);

      & svg {
        color: var(--color-text);
      }
    }
  }

  .discord {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin-top: auto;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-discord);
    color: white;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background-color var(--transition);

    @media (hover: hover) {
      &:hover {
        background: color-mix(in srgb, var(--color-discord) 85%, black);
      }
    }
  }

  @media (width < 40rem) {
    header .bar:has(.page) .name {
      display: none;
    }

    .page {
      margin-left: 0;
    }
  }
</style>
