---
import type { ComponentProps } from "astro/types";
import Container from "./Container.astro";
import DocsNav from "./DocsNav.astro";

interface Props extends ComponentProps<typeof DocsNav> {
  heading: string;
  summary: string;
}

const { heading, summary, ...nav } = Astro.props;
---

<Container width="wide" class="docs">
  <aside>
    <DocsNav {...nav} />
  </aside>

  <details class="pages">
    <summary>Pages</summary>
    <DocsNav {...nav} />
  </details>

  <article class="doc">
    <h1>{heading}</h1>
    <p class="summary">{summary}</p>
    <slot />
  </article>
</Container>

<style>
  .docs {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    padding-block: 3rem 4rem;
  }

  aside > :global(nav) {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100dvh - var(--nav-height) - 3rem);
    overflow-y: auto;
  }

  .pages {
    display: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);

    & summary {
      padding: 0.75rem 1rem;
      color: var(--color-text-secondary);
      font-size: var(--text-sm);
      cursor: pointer;
    }

    & > :global(nav) {
      padding: 0.25rem 1rem 1rem;
    }
  }

  @media (width < 48rem) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }

    aside {
      display: none;
    }

    .pages {
      display: block;
    }
  }

  h1 {
    margin-bottom: 0.5rem;
    font-size: var(--text-2xl);
  }

  .summary {
    margin-bottom: 2.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .doc :global(section) {
    margin-bottom: 2.5rem;
  }

  .doc :global(section > h2) {
    margin-bottom: 0.75rem;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .doc :global(section > h2:not(:first-child)) {
    margin-top: 2rem;
  }

  .doc :global(section > :is(p, ul)) {
    margin-bottom: 0.75rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .doc :global(section > ul) {
    padding-left: 1.25rem;
  }

  .doc :global(li + li) {
    margin-top: 0.5rem;
  }

  .doc :global(section > p a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .doc :global(pre),
  .doc :global(.table),
  .doc :global(section > table) {
    margin-bottom: 0.75rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    font-size: var(--text-code);
  }

  .doc :global(pre) {
    padding: 0.625rem 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .doc :global(table) {
    width: 100%;
    border-collapse: collapse;
  }

  .doc :global(th),
  .doc :global(td) {
    padding: 0.5rem 0.75rem;
    color: var(--color-text-muted);
    text-align: left;
    vertical-align: top;
  }

  .doc :global(th) {
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .doc :global(tr + tr) {
    border-top: 1px solid var(--color-divider);
  }

  .doc :global(td:first-child) {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
</style>
