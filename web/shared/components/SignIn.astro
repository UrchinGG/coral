---
import { CORAL_API_URL } from "astro:env/server";
---

<div class="account" data-api={CORAL_API_URL}>
  <a
    class="sign-in"
    href={`${CORAL_API_URL}/auth/discord`}
    aria-label="Sign in"
  >
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path d="M8 7.75a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5zM2.75 13.75c.5-2.3 2.6-3.75 5.25-3.75s4.75 1.45 5.25 3.75"></path>
    </svg>
    <span>Sign in</span>
  </a>
  <button
    class="profile"
    type="button"
    aria-label="Account"
    popovertarget="account-menu"
    hidden
  >
    <img alt="" width="28" height="28" />
  </button>
  <div id="account-menu" class="menu" popover>
    <div class="who">
      <strong></strong>
      <span></span>
    </div>
    <button class="sign-out" type="button">
      Sign out
    </button>
  </div>
</div>

<script>
  import { account, signInUrl, signOut } from "../account";

  const root = document.querySelector<HTMLElement>(".account")!;
  const api = root.dataset.api!;
  const signIn = root.querySelector<HTMLAnchorElement>(".sign-in")!;
  const profile = root.querySelector<HTMLButtonElement>(".profile")!;

  signIn.href = signInUrl(api);
  const me = await account(api);
  if (me) {
    signIn.hidden = true;
    profile.hidden = false;
    profile.querySelector("img")!.src = me.avatar;
    root.querySelector(".who strong")!.textContent = me.name;
    root.querySelector(".who span")!.textContent = me.rank ?? "";
    root
      .querySelector(".sign-out")!
      .addEventListener("click", () => signOut(api));
  }
</script>

<style>
  .account {
    flex: none;
    margin-left: auto;
  }

  .sign-in {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color var(--transition),
      background-color var(--transition),
      color var(--transition);

    & path {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.4;
    }

    @media (hover: hover) {
      &:hover {
        border-color: var(--color-border-hover);
        background: var(--color-surface-raised);
        color: var(--color-text);
      }
    }
  }

  .profile {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;

    & img {
      border-radius: 50%;
      transition: opacity var(--transition);
    }

    @media (hover: hover) {
      &:hover img {
        opacity: 0.85;
      }
    }
  }

  .menu {
    inset: calc(var(--nav-height) + 0.25rem) var(--gutter) auto auto;
    width: 13rem;
    margin: 0;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-panel);
    box-shadow: var(--shadow-float);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .who {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.625rem 0.625rem;
    border-bottom: 1px solid var(--color-divider);

    & strong {
      overflow: hidden;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    & span {
      color: var(--color-text-muted);
      font-size: var(--text-xs);

      &:empty {
        display: none;
      }
    }
  }

  .sign-out {
    width: 100%;
    margin-top: 0.375rem;
    padding: 0.5rem 0.625rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
        color: var(--color-text);
      }
    }
  }

  @media (width < 40rem) {
    .sign-in {
      width: 2.25rem;
      justify-content: center;
      padding: 0;

      & span {
        display: none;
      }
    }
  }
</style>
