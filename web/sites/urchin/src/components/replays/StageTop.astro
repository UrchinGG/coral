---
import Icon from "./Icon.astro";
import TopBar from "./TopBar.astro";
---

<div class="stage-top">
  <TopBar>
    <div id="pill" class="pill card" hidden>
      <button
        id="pill-prev"
        class="icon-button"
        type="button"
        aria-label="Previous player"
        data-tip
        data-key=","
      >
        <Icon name="back" />
      </button>
      <button
        id="pill-who"
        class="who"
        type="button"
        aria-label="Auto camera"
        aria-pressed="false"
        data-tip
      >
        <span id="pill-face" class="face"></span>
        <span class="name mc">
          <b id="pill-team"></b>
          <span id="pill-name"></span>
          <span id="pill-nick" class="nick"></span>
        </span>
        <small id="pill-state" class="mc"></small>
      </button>
      <button
        id="pill-next"
        class="icon-button"
        type="button"
        aria-label="Next player"
        data-tip
        data-key="."
      >
        <Icon name="forward" />
      </button>
    </div>
  </TopBar>

  <div id="gpu-notice" class="notice" role="status" hidden>
    <Icon name="warning" />
    <p>
      <strong>Hardware acceleration is off</strong>, so the viewer will be slow.
      Turn on “Use graphics acceleration when available” in your browser's
      System settings, then restart the browser.
    </p>
    <button
      id="gpu-notice-close"
      class="icon-button"
      type="button"
      aria-label="Dismiss"
    >
      <Icon name="close" />
    </button>
  </div>

  <p id="fly-hint" class="hint card" hidden>
    Click the view to look around · <kbd>W</kbd>
    <kbd>A</kbd>
    <kbd>S</kbd>
    <kbd>D</kbd> move · <kbd>Space</kbd> / <kbd>Shift</kbd> up and down · scroll
    for speed · <kbd>P</kbd> pause
  </p>
</div>

<style>
  .stage-top {
    position: absolute;
    z-index: 10;
    top: 0.75rem;
    right: var(--panel-inset);
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    pointer-events: none;
    transition: right var(--transition);

    & > * {
      pointer-events: auto;
    }
  }

  .notice {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    max-width: 35rem;
    padding: 0.625rem 0.375rem 0.625rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(
      in srgb,
      var(--color-warning) 8%,
      var(--color-background)
    );
    color: color-mix(in srgb, var(--color-warning) 45%, var(--color-text));
    line-height: 1.5;

    & > svg {
      margin-top: 0.125rem;
      color: var(--color-warning);
    }

    & strong {
      color: var(--color-text);
      font-weight: 600;
    }

    & .icon-button {
      margin-top: -0.375rem;
      color: inherit;
    }
  }

  .pill,
  .hint {
    border-radius: var(--radius-lg);
    transition:
      opacity var(--transition),
      translate var(--transition),
      display var(--transition) allow-discrete;

    &[hidden] {
      opacity: 0;
      translate: 0 -0.25rem;
    }

    @starting-style {
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    height: var(--bar-height);
    padding: 0 0.25rem;
    pointer-events: auto;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: background-color var(--transition);

    &[aria-pressed="true"] {
      background: var(--color-surface-raised);
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-surface-raised);
      }

      &[aria-pressed="true"]:hover {
        background: var(--color-surface-raised-hover);
      }
    }
  }

  .name {
    color: var(--color);
    font-size: var(--text-2xs);
    transition: color var(--transition);

    & b {
      margin-right: 0.45em;
      font-weight: 700;

      &:empty {
        display: none;
      }
    }
  }

  #pill-state {
    color: var(--mc-gray);
    font-size: var(--text-3xs);

    &:empty {
      display: none;
    }
  }

  .pill:not([data-state="alive"]) {
    & .face {
      filter: grayscale(1) brightness(0.6);
    }

    & .name {
      color: var(--mc-gray);
    }
  }

  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.5rem 0.875rem;
    color: var(--color-text-secondary);

    & kbd {
      min-width: 1rem;
      padding: 0 0.25rem;
      font-size: var(--text-3xs);
      line-height: 1rem;
    }
  }
</style>
