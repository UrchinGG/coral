---
import Icon from "./Icon.astro";
---

<aside id="library" class="drawer card" aria-label="Library" inert>
  <h1 class="intro">Replay viewer</h1>

  <section class="open">
    <button id="file-button" class="button primary" type="button">
      <Icon name="file" />
      Open a file
    </button>
    <input id="file-input" type="file" accept=".mcpr,.urp" hidden />
    <p class="note">Or drop a .mcpr or .urp file anywhere on the page.</p>
    <form id="url-form" class="url">
      <input
        id="url-input"
        class="field"
        name="src"
        type="url"
        required
        placeholder="Replay URL"
        aria-label="Replay URL"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="button" type="submit">
        Open
      </button>
    </form>
  </section>
</aside>

<div id="drop" class="drop" hidden>
  <p>Drop the replay to open it</p>
</div>

<style>
  .drawer {
    position: absolute;
    z-index: 20;
    top: calc(0.75rem + var(--bar-height) + 0.5rem);
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    width: min(22.5rem, 100% - 1.5rem);
    max-height: calc(100% - var(--bar-height) - 2rem);
    overflow-y: auto;
    border-radius: var(--radius-lg);
    transition:
      opacity var(--transition),
      translate var(--transition),
      visibility var(--transition);

    &[inert] {
      visibility: hidden;
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }

  :global(.stage[data-empty]) .drawer {
    inset: 0;
    width: min(26rem, 100% - 2rem);
    height: fit-content;
    max-height: calc(100% - 2rem);
    margin: auto;
    translate: none;

    & .intro {
      display: block;
    }
  }

  .intro {
    display: none;
    padding: 1.5rem 1rem 0;
    font-size: var(--text-lg);
  }

  .open {
    display: grid;
    gap: 0.625rem;
    padding: 1rem;
  }

  .primary {
    border-color: transparent;
    background: var(--color-text);
    color: var(--color-background);

    @media (hover: hover) {
      &:hover {
        border-color: transparent;
        background: var(--color-text-secondary);
        color: var(--color-background);
      }
    }
  }

  .note {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .url {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.25rem;

    & .field {
      flex: 1;
    }
  }

  .drop {
    position: fixed;
    z-index: 50;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: var(--color-scrim);
    pointer-events: none;
    transition:
      opacity var(--transition),
      display var(--transition) allow-discrete;

    &[hidden] {
      opacity: 0;
    }

    @starting-style {
      opacity: 0;
    }

    & p {
      padding: 1.5rem 2rem;
      border: 1px dashed var(--color-text-muted);
      border-radius: var(--radius-lg);
      background: var(--color-panel);
      font-size: var(--text-sm);
      font-weight: 500;
    }
  }
</style>
