---
import Icon from "./Icon.astro";

const tabs = [
  { id: "players", label: "Players" },
  { id: "events", label: "Events" },
  { id: "chat", label: "Chat" },
];

const kinds = [
  { kind: "kill", label: "Kills" },
  { kind: "final", label: "Finals" },
  { kind: "bed", label: "Beds" },
  { kind: "eliminated", label: "Teams" },
];
---

<aside id="match" class="panel" aria-label="Match" inert>
  <div class="tabs segmented" role="tablist" aria-label="Match">
    {tabs.map(({ id, label }, index) => (
      <button
        id={`tab-${id}`}
        class="tab"
        type="button"
        role="tab"
        aria-controls={id}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-tab={id}
      >
        {label}
        {id === "events" && <span id="event-count" class="count" />}
      </button>
    ))}
  </div>

  <section
    id="players"
    class="view"
    role="tabpanel"
    aria-labelledby="tab-players"
  >
    <div class="roster-head" aria-hidden="true">
      <span title="Kills">K</span>
      <span title="Final kills">FK</span>
      <span title="Beds broken">B</span>
    </div>
    <div id="roster" class="roster"></div>
  </section>

  <section
    id="events"
    class="view"
    role="tabpanel"
    aria-labelledby="tab-events"
    hidden
  >
    <div class="toolbar">
      <div class="chips segmented" role="group" aria-label="Show">
        {kinds.map(({ kind, label }) => (
          <button
            class="chip"
            type="button"
            data-kind={kind}
            aria-pressed={kind === "kill" ? "false" : "true"}
          >
            {label}
          </button>
        ))}
      </div>
      <span class="steps">
        <button
          id="event-prev"
          class="icon-button"
          type="button"
          aria-label="Previous event"
          data-tip
        >
          <Icon name="back" />
        </button>
        <button
          id="event-next"
          class="icon-button"
          type="button"
          aria-label="Next event"
          data-tip
        >
          <Icon name="forward" />
        </button>
      </span>
    </div>
    <div id="event-list" class="list"></div>
    <p id="event-empty" class="empty" hidden></p>
  </section>

  <section
    id="chat"
    class="view"
    role="tabpanel"
    aria-labelledby="tab-chat"
    hidden
  >
    <div id="chat-log" class="list chat-log"></div>
    <p id="chat-empty" class="empty" hidden>
      No chat in this replay.
    </p>
  </section>
</aside>

<style>
  .panel {
    position: absolute;
    z-index: 16;
    inset: 0 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(100%, 18.75rem);
    border-left: 1px solid var(--color-divider);
    background: var(--color-background);
    transition:
      translate var(--transition),
      visibility var(--transition);

    &[inert] {
      visibility: hidden;
      translate: 100% 0;
    }

    @media (width <= 56.25rem) {
      width: min(100%, 22.5rem);
      box-shadow: var(--shadow-float);
    }

    @media (width < 40rem) {
      width: 100%;
      border-left: 0;
    }
  }

  .tabs {
    margin: 0.625rem 0.625rem 0.375rem;
  }

  .tab {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 1.875rem;

    @media (pointer: coarse) {
      height: 2.5rem;
    }
  }

  .count {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .view {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .roster-head,
  .roster :global(.stats) {
    display: grid;
    grid-template-columns: repeat(3, 1.375rem);
    gap: 0.125rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .roster-head {
    position: sticky;
    z-index: 1;
    top: 0;
    justify-content: end;
    padding: 0.25rem 1.375rem 0.25rem 0;
    background: var(--color-background);
    color: var(--color-text-muted);
    font-size: var(--text-3xs);
    font-weight: 600;
  }

  .roster {
    display: grid;
    gap: 0.5rem;
    padding: 0 0.625rem 0.875rem;

    & :global(.team) {
      display: grid;
      gap: 1px;
      padding: 0.25rem;
      border-left: 3px solid var(--color);
      border-radius: var(--radius-xs) var(--radius) var(--radius)
        var(--radius-xs);
      background: var(--color-surface-hover);
      transition: border-color var(--transition);
    }

    & :global(.team[data-status="out"]) {
      border-left-color: color-mix(in srgb, var(--color) 35%, transparent);
    }

    & :global(.team-head) {
      padding: 0.3125rem 0.5rem 0.25rem;
      font-size: var(--text-2xs);
      white-space: pre;
    }

    & :global(.state) {
      color: var(--mc-green);
      font-weight: 700;
    }

    & :global(.team[data-status="bedless"] .state) {
      font-weight: 400;
    }

    & :global(.team[data-status="out"] .state) {
      color: var(--mc-red);
    }

    & :global(.player) {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.625rem;
      width: 100%;
      min-height: 2.125rem;
      padding: 0.3125rem 0.5rem;
      border: 0;
      border-radius: var(--radius-sm);
      background: none;
      text-align: left;
      transition: background-color var(--transition);

      @media (pointer: coarse) {
        min-height: 2.625rem;
      }

      @media (hover: hover) {
        &:hover {
          background: var(--color-surface-raised);
        }
      }

      &[aria-current] {
        background: var(--color-surface-raised-hover);
        box-shadow: inset 3px 0 0 var(--color-text);
      }
    }

    & :global(.name) {
      color: var(--color);
      font-size: var(--text-2xs);
      overflow-wrap: anywhere;
      transition: color var(--transition);
    }

    & :global(.stats) {
      color: var(--color-text-secondary);
      font-weight: 500;
    }

    & :global(.player:is([data-state="dead"], [data-state="out"])) {
      & .face {
        filter: grayscale(1) brightness(0.6);
      }

      & .name {
        color: var(--mc-gray);
      }

      & .stats {
        color: var(--color-text-muted);
      }
    }

    & :global(.player[data-state="out"] .name) {
      text-decoration: line-through;
    }
  }

  .toolbar {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem 0.375rem;
    background: var(--color-background);
  }

  .chip {
    height: 1.625rem;
    padding: 0 0.4375rem;

    @media (pointer: coarse) {
      height: 2.25rem;
    }
  }

  .steps {
    display: flex;
  }

  .list {
    display: grid;
    gap: 1px;
    padding: 0 0.625rem 0.875rem;

    & :global(.row) {
      display: grid;
      grid-template-columns: 2.125rem minmax(0, 1fr);
      align-items: baseline;
      gap: 0.625rem;
      width: 100%;
      padding: 0.375rem 0.5rem;
      border: 0;
      border-radius: var(--radius-sm);
      background: none;
      color: var(--mc-gray);
      text-align: left;
      transition:
        background-color var(--transition),
        opacity var(--transition);

      @media (hover: hover) {
        &:hover {
          background: var(--color-surface-raised);
        }
      }

      @media (pointer: coarse) {
        min-height: 2.75rem;
        align-content: center;
      }
    }

    & :global(.upcoming) {
      opacity: 0.45;

      @media (hover: hover) {
        &:hover {
          opacity: 0.85;
        }
      }
    }

    & :global(time) {
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      font-variant-numeric: tabular-nums;
    }

    & :global(.mc) {
      font-size: var(--text-2xs);
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
  }

  .chat-log :global(.mc) {
    font-size: var(--text-3xs);
  }

  .empty {
    padding: 0.875rem 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
