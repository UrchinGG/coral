---
import MicrosoftSignIn from "@/components/dashboard/MicrosoftSignIn.astro";
import Player from "@/components/dashboard/Player.astro";
---

<template id="lent-row">
  <div class="row">
    <div class="line">
      <Player />
      <button
        class="stop"
        type="button"
        data-action="stop-now"
        title="Another bot takes over its task"
      >
        Stop now
      </button>
      <button
        class="icon"
        type="button"
        data-action="menu"
        popovertarget="lent-menu"
        aria-haspopup="menu"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="3.5" cy="8" r="1.25"></circle>
          <circle cx="8" cy="8" r="1.25"></circle>
          <circle cx="12.5" cy="8" r="1.25"></circle>
        </svg>
      </button>
    </div>

    <div class="reconnect" hidden>
      <MicrosoftSignIn>
        Microsoft signed this account out. Sign it back in to keep it running.
      </MicrosoftSignIn>
    </div>
  </div>
</template>

<style>
  .row {
    padding: 0.75rem 0.75rem 0.75rem 1rem;

    & + .row {
      border-top: 1px solid var(--color-divider);
    }
  }

  .line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.5rem;
    align-items: center;
  }

  .reconnect {
    margin: 0.75rem 0.25rem 0.25rem calc(40px + 0.875rem);
  }

  .row:not([data-status="finishing"]) .stop {
    display: none;
  }

  [data-status="paused"] :global(img) {
    filter: grayscale(1);
    opacity: 0.5;
  }

  [data-status="signed-out"] :global(.detail) {
    color: var(--color-warning);
  }

  [data-status="banned"] :global(.detail) {
    color: var(--color-danger);
  }

  @media (width < 30rem) {
    .line {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .stop {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: start;
      margin-left: calc(40px + 0.875rem);
    }

    .reconnect {
      margin-left: 0;
    }
  }
</style>
