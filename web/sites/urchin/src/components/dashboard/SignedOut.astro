<section class="signed-out" hidden>
  <h1>Dashboard</h1>
  <p>Sign in with Discord to manage your API keys, Starfish and more.</p>
  <a class="button primary">Sign in with Discord</a>
</section>

<script>
  import { me, signInLink } from "@/dashboard/api";

  const section = document.querySelector<HTMLElement>(".signed-out")!;
  if (!(await me)) {
    section.querySelector("a")!.href = signInLink();
    section.hidden = false;
  }
</script>

<style>
  .signed-out {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding-block: 2rem;

    & h1 {
      font-size: var(--text-lg);
    }

    & p {
      color: var(--color-text-muted);
      font-size: var(--text-sm);
    }
  }
</style>
