---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

<button
  class="icon copy"
  type="button"
  data-action="copy"
  data-copy={text}
  aria-label="Copy"
>
  <svg
    class="idle"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    aria-hidden="true"
  >
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
    <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5"></path>
  </svg>
  <svg
    class="done"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    aria-hidden="true"
  >
    <path d="m3.5 8.5 3 3 6-7"></path>
  </svg>
</button>

<style>
  .done,
  [data-copied] .idle {
    display: none;
  }

  [data-copied] .done {
    display: block;
    color: var(--mc-green);
  }
</style>
