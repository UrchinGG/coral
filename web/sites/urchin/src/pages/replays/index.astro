---
import Head from "@shared/components/Head.astro";
import Header from "@shared/components/Header.astro";
import "@shared/styles/global.css";
import "@/styles/minecraft.css";
import "@/replays/replays.css";
import ChatHud from "@/components/replays/ChatHud.astro";
import HelpDialog from "@/components/replays/HelpDialog.astro";
import Library from "@/components/replays/Library.astro";
import Loading from "@/components/replays/Loading.astro";
import MatchPanel from "@/components/replays/MatchPanel.astro";
import Notices from "@/components/replays/Notices.astro";
import PlaybackBar from "@/components/replays/PlaybackBar.astro";
import StageTop from "@/components/replays/StageTop.astro";
import { ASSETS, assetUrl } from "@/replays/assets";
import { viewerWasm } from "@/viewer/wasm";
---

<html lang="en">
  <Head
    siteName="Urchin"
    logo="/brand/urchin.svg"
    title="Replays"
    description="Watch recorded Hypixel games in your browser."
    edgeToEdge
  >
    {viewerWasm && (
      <>
        <link
          rel="preload"
          href={viewerWasm}
          as="fetch"
          type="application/wasm"
          crossorigin
        />
        {ASSETS.map((name) => (
          <link rel="preload" href={assetUrl(name)} as="fetch" crossorigin />
        ))}
      </>
    )}
  </Head>
  <body>
    <div class="app">
      <Header site="urchin" />
      <main id="stage" class="stage" data-empty>
        <canvas id="view" aria-label="Replay view"></canvas>
        <div class="crosshair" aria-hidden="true"></div>
        <StageTop />
        <ChatHud />
        <PlaybackBar />
        <MatchPanel />
        <Loading />
        <Library />
        <Notices />
      </main>
    </div>
    <HelpDialog />
  </body>
</html>

<script>
  import "@/replays/app";
</script>

<style>
  .app {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100dvh;
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
  }

  .stage {
    --panel-inset: 0px;
    --transport-inset: 6rem;
    --bar-height: 2.5rem;
    position: relative;
    isolation: isolate;
    overflow: hidden;

    @media (pointer: coarse) {
      --bar-height: 3.25rem;
    }

    @media (width > 56.25rem) {
      &[data-panel] {
        --panel-inset: 18.75rem;
      }
    }

    &[data-empty] {
      --panel-inset: 0px;

      & :global(:is(.replay-bar, #transport, #match)) {
        visibility: hidden;
      }
    }
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    display: none;
    width: 15px;
    height: 15px;
    translate: -50% -50%;
    background:
      linear-gradient(var(--color-text), var(--color-text)) center / 11px 1px
        no-repeat,
      linear-gradient(var(--color-text), var(--color-text)) center / 1px 11px
        no-repeat;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .stage:is([data-camera="fly"], [data-camera="pov"]):not([data-chat])
    .crosshair {
    display: block;
  }
</style>
