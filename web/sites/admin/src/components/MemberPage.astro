---
import { page } from "@/lib/paths";
---

<section id="member-page" class="member" hidden>
  <nav class="crumbs-nav" aria-label="Breadcrumb">
    <a href={page("/urchin/members")}>Members</a>
    <span aria-hidden="true">/</span>
    <span data-crumb></span>
  </nav>
  <header class="member-head">
    <div class="member-title">
      <h1 data-name>Loading…</h1>
      <div class="meta" data-meta></div>
      <div class="issues" data-issues></div>
    </div>
    <div class="actions" data-actions></div>
  </header>
  <div class="tabs" role="tablist" aria-label="Member sections" data-tabs></div>
  <p class="muted" data-status></p>
  <div data-tab></div>

  <dialog data-dialog="strike">
    <form method="dialog" class="dialog-form">
      <h2>Strike</h2>
      <label>
        Reason <input class="field" name="reason" maxlength="100" required />
      </label>
      <label>
        Length
        <select class="field" name="duration_days">
          <option value="14">14 days</option>
          <option value="30">30 days</option>
        </select>
      </label>
      <div class="actions">
        <button class="button" value="cancel" formnovalidate>
          Cancel
        </button>
        <button class="button primary" value="confirm">
          Strike
        </button>
      </div>
    </form>
  </dialog>
  <dialog data-dialog="access">
    <form method="dialog" class="dialog-form">
      <h2>Access Level</h2>
      <select class="field" name="level">
        <option value="0">Default</option>
        <option value="2">Helper</option>
        <option value="3">Moderator</option>
        <option value="4">Admin</option>
      </select>
      <div class="actions">
        <button class="button" value="cancel" formnovalidate>
          Cancel
        </button>
        <button class="button primary" value="confirm">
          Save
        </button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import { page } from "@/lib/paths";
  import {
    BELOW_YOU,
    can,
    outranks,
    rankOf,
    session,
    type Permission,
  } from "@/lib/session";
  import { memberRequestsTab } from "@/lib/tabs/requests";
  import { load, send } from "@/lib/api";
  import { el, panel, row, widePanel } from "@/lib/dom";
  import { FORMATS } from "@/lib/format";
  import { accessLabel, memberUrl, type Labels } from "@/lib/members";
  import {
    networkTab,
    rawTab,
    starfishTab,
    timelineTab,
  } from "@/lib/tabs/member";
  import {
    blocksPanel,
    developerPanel,
    masked,
    type BlockState,
    type Budget,
    type DevKey,
    type WasteStanding,
  } from "@/lib/tabs/keys";
  import { ago, day } from "@/lib/time";

  interface Ref {
    discord_id?: string;
    uuid?: string;
  }

  interface Strike {
    id: number;
    reason: string;
    struck_by: Ref;
    issued_at: string;
    expires_at: string | null;
    status: string;
  }

  interface Core {
    account: Ref;
    member: {
      id: number;
      access_level: number;
      key_locked: boolean;
      tagging_disabled: boolean;
      join_date: string;
      last_request_at: string | null;
      request_count: number;
      is_owner: boolean;
    } | null;
    keys: {
      personal: string | null;
      developer: DevKey | null;
    };
    minecraft: { player: Ref; relation: string; linked_at: string | null }[];
    former_minecraft: number;
    standing: {
      can_vote: boolean;
      vote_reason: string;
      can_tag: boolean;
      tag_reason: string;
      accepted_tags: number;
      rejected_tags: number;
      accurate_verdicts: number;
      incorrect_verdicts: number;
    } | null;
    strikes: { active: number; items: Strike[] };
    activity: { h24: { requests: number }; d14: { requests: number } };
    starfish: { license_status: string } | null;
    labels: Labels;
  }

  const id = new URLSearchParams(location.search).get("id");
  const viewer = await session();
  const NO_WASTE: WasteStanding = {
    allowance: 0,
    refill_per_day: 0,
    spent: 0,
    blocked_until: null,
  };
  const root = document.getElementById("member-page")!;
  const part = <T extends HTMLElement>(name: string) =>
    root.querySelector<T>(`[data-${name}]`)!;
  const dialog = (name: string) =>
    root.querySelector<HTMLDialogElement>(`[data-dialog="${name}"]`)!;

  const nameOf = (ref: Ref, labels: Labels) =>
    ref.discord_id
      ? (labels.discord[ref.discord_id] ?? ref.discord_id)
      : (labels.minecraft[ref.uuid!] ?? ref.uuid!);

  async function act(path: string, body?: unknown, method = "POST") {
    const ok = await send(
      `/accounts/${id}${path}`,
      method,
      method === "DELETE" ? undefined : (body ?? {}),
    );
    part("status").textContent = ok
      ? ""
      : "That didn't work; the change was not saved.";
    if (ok) show();
  }

  function ask(name: string, then: (form: FormData) => void) {
    const box = dialog(name);
    box.showModal();
    box.addEventListener(
      "close",
      () =>
        box.returnValue === "confirm" &&
        then(new FormData(box.querySelector("form")!)),
      { once: true },
    );
  }

  const change = (path: string, method: string, body?: unknown) =>
    act(path, body, method);

  function header(core: Core, blocks: BlockState) {
    const name = nameOf(core.account, core.labels);
    const member = core.member;
    document.title = `${name} | Urchin Admin`;
    part("crumb").textContent = name;
    part("name").textContent = name;
    part("meta").replaceChildren(
      ...[
        member && accessLabel(member.access_level),
        member && `#${member.id}`,
        member && `Joined ${day(member.join_date)}`,
        member && `Active ${ago(member.last_request_at)}`,
        core.account.discord_id!,
      ]
        .filter(Boolean)
        .map((text) => el("span", {}, text as string)),
    );
    const issues = [
      member?.key_locked && "Key locked",
      core.strikes.active &&
        `${core.strikes.active} active ${core.strikes.active === 1 ? "strike" : "strikes"}`,
      member?.tagging_disabled && "Tagging disabled",
      blocks.waste.blocked_until &&
        `Blocked for wasting Hypixel calls until ${day(blocks.waste.blocked_until)}`,
    ].filter(Boolean) as string[];
    part("issues").replaceChildren(
      ...issues.map((text) => el("span", { className: "issue" }, text)),
    );
    part("actions").replaceChildren(...(member ? actions(member) : []));
  }

  const above = (member: NonNullable<Core["member"]>) =>
    !outranks(viewer, rankOf(member.access_level, member.is_owner));

  function keyMenu(member: NonNullable<Core["member"]>) {
    const options = [
      can(viewer, "keys_manage") &&
        el("option", {
          value: member.key_locked ? "unlock" : "lock",
          textContent: member.key_locked ? "Unlock Key" : "Lock Key",
        }),
      can(viewer, "keys_manage") &&
        el("option", {
          value: "api-key/regenerate",
          textContent: "Regenerate Key",
        }),
      can(viewer, "key_limits_write") &&
        el("option", { value: "limits/reset", textContent: "Reset Limits" }),
    ].filter((option): option is HTMLOptionElement => Boolean(option));
    if (!options.length) return [];
    const menu = el("select", { className: "field", ariaLabel: "API key" });
    menu.append(
      el("option", { value: "", textContent: "API Key…" }),
      ...options,
    );
    menu.disabled = above(member);
    if (menu.disabled) menu.title = BELOW_YOU;
    menu.addEventListener("change", () => {
      const path = menu.value;
      menu.value = "";
      if (
        path &&
        confirm(
          `${menu.querySelector(`option[value="${path}"]`)?.textContent ?? path}?`,
        )
      )
        act(`/${path}`);
    });
    return [menu];
  }

  function actions(member: NonNullable<Core["member"]>) {
    const button = (
      label: string,
      needs: Permission,
      run: () => void,
      className = "button",
    ) => {
      if (!can(viewer, needs)) return [];
      const element = el("button", {
        type: "button",
        className,
        textContent: label,
        disabled: above(member),
        title: above(member) ? BELOW_YOU : "",
      });
      element.addEventListener("click", run);
      return [element];
    };
    return [
      ...button(
        "Strike",
        "strikes_write",
        () =>
          ask("strike", (form) =>
            act("/strikes", {
              reason: form.get("reason"),
              duration_days: Number(form.get("duration_days")),
            }),
          ),
        "button danger",
      ),
      ...button(
        member.tagging_disabled ? "Enable Tagging" : "Disable Tagging",
        "tagging_write",
        () => act("/tagging", { disabled: !member.tagging_disabled }),
      ),
      ...button("Access Level", "access_level_write", () => {
        (dialog("access").querySelector("select") as HTMLSelectElement).value =
          String(member.access_level);
        ask("access", (form) =>
          act("/access-level", { level: Number(form.get("level")) }),
        );
      }),
      ...keyMenu(member),
    ];
  }

  function overview(core: Core, blocks: BlockState) {
    const accounts = core.minecraft.map((link) =>
      row(
        link.relation === "primary" ? "Primary" : "Alt",
        nameOf(link.player, core.labels),
        el(
          "span",
          { className: "dim" },
          link.linked_at ? ` · ${day(link.linked_at)}` : "",
        ),
      ),
    );
    const member = core.member;
    const standing = core.standing;
    const strikes = core.strikes.items.map((strike) => {
      const revoke = el("button", {
        type: "button",
        className: "button small",
        textContent: "Revoke",
      });
      revoke.addEventListener("click", async () => {
        if (
          confirm(`Revoke the strike for "${strike.reason}"?`) &&
          (await send(`/accounts/${id}/strikes/${strike.id}`, "DELETE"))
        )
          show();
      });
      revoke.disabled = member ? above(member) : false;
      if (revoke.disabled) revoke.title = BELOW_YOU;
      return row(
        strike.reason,
        `${nameOf(strike.struck_by, core.labels)} · ${day(strike.issued_at)}${strike.expires_at ? ` to ${day(strike.expires_at)}` : ""}`,
        strike.status === "active" && can(viewer, "strikes_write")
          ? revoke
          : el("span", { className: "dim" }, ` · ${strike.status}`),
      );
    });
    return [
      panel(
        "Minecraft Accounts",
        ...(accounts.length ? accounts : [row("None", "No linked accounts")]),
        ...(core.former_minecraft
          ? [row("Former", `${core.former_minecraft} unlinked`)]
          : []),
      ),
      panel(
        "Usage",
        row("Requests, 24 h", FORMATS.number(core.activity.h24.requests)),
        row("Requests, 14 d", FORMATS.number(core.activity.d14.requests)),
        row("Requests, total", FORMATS.number(member?.request_count ?? 0)),
        ...(can(viewer, "keys_manage")
          ? [
              row(
                "API key",
                core.keys.personal ? masked(core.keys.personal) : "None",
              ),
            ]
          : []),
      ),
      ...(can(viewer, "key_limits_write") ? [blocksPanel(blocks, change)] : []),
      ...(member && can(viewer, "keys_manage")
        ? [developerPanel(core.keys.developer, change)]
        : []),
      ...(standing
        ? [
            panel(
              "Standing",
              row(
                "Voting",
                standing.can_vote ? "Allowed" : standing.vote_reason,
              ),
              row(
                "Tagging",
                standing.can_tag ? "Allowed" : standing.tag_reason,
              ),
              row(
                "Submissions",
                `${standing.accepted_tags} accepted, ${standing.rejected_tags} rejected`,
              ),
              row(
                "Verdicts",
                `${standing.accurate_verdicts} accurate, ${standing.incorrect_verdicts} incorrect`,
              ),
            ),
          ]
        : []),
      widePanel(
        "Strikes",
        ...(strikes.length ? strikes : [row("None", "No strikes on record")]),
      ),
    ];
  }

  const TABS: [string, string, Permission][] = [
    ["overview", "Overview", "members_read"],
    ["timeline", "Timeline", "members_read"],
    ["starfish", "Starfish", "starfish"],
    ["requests", "Requests", "traffic"],
    ["network", "Keys & Network", "keys_manage"],
    ["raw", "Raw", "keys_manage"],
  ];

  let current = new URLSearchParams(location.search).get("tab") ?? "overview";

  async function tabContent(core: Core, blocks: BlockState): Promise<Node> {
    switch (current) {
      case "timeline":
        return timelineTab(id!);
      case "starfish":
        return starfishTab(id!, show);
      case "requests":
        return memberRequestsTab(id!);
      case "network":
        return networkTab(id!);
      case "raw":
        return rawTab(
          core.member as unknown as { row: unknown; config: unknown } | null,
        );
      default:
        return el("div", { className: "panels" }, ...overview(core, blocks));
    }
  }

  function tabs(core: Core, blocks: BlockState) {
    const available = TABS.filter(
      ([key, , needs]) =>
        can(viewer, needs) && (key !== "starfish" || core.starfish),
    );
    if (!available.some(([key]) => key === current)) current = "overview";
    part("tabs").replaceChildren(
      ...available.map(([key, label]) => {
        const tab = el("button", {
          type: "button",
          role: "tab",
          textContent: label,
        });
        tab.setAttribute("aria-selected", String(key === current));
        tab.addEventListener("click", () => {
          current = key;
          history.replaceState(
            null,
            "",
            `${memberUrl(id!)}${key === "overview" ? "" : `&tab=${key}`}`,
          );
          tabs(core, blocks);
          renderTab(core, blocks);
        });
        return tab;
      }),
    );
  }

  async function renderTab(core: Core, blocks: BlockState) {
    const container = part("tab");
    container.replaceChildren(
      el("p", { className: "muted", textContent: "Loading…" }),
    );
    try {
      container.replaceChildren(await tabContent(core, blocks));
    } catch (error) {
      container.replaceChildren(
        el("p", { className: "muted", textContent: (error as Error).message }),
      );
    }
  }

  async function show() {
    try {
      const keyLimits = can(viewer, "key_limits_write");
      const [core, waste, limits] = await Promise.all([
        load<Core>(`/accounts/${id}`),
        keyLimits
          ? load<WasteStanding>(`/accounts/${id}/waste`)
          : Promise.resolve(NO_WASTE),
        keyLimits
          ? load<Budget[]>(`/accounts/${id}/limits`)
          : Promise.resolve<Budget[]>([]),
      ]);
      const blocks: BlockState = {
        keyLocked: core.member?.key_locked ?? false,
        taggingDisabled: core.member?.tagging_disabled ?? false,
        developer: core.keys.developer,
        waste,
        limits,
      };
      header(core, blocks);
      tabs(core, blocks);
      renderTab(core, blocks);
    } catch (error) {
      part("status").textContent = (error as Error).message;
    }
  }

  const ALIASES: [string, string][] = [
    ["member", "by-member"],
    ["starfish", "by-starfish"],
  ];
  const alias = ALIASES.find(([param]) =>
    new URLSearchParams(location.search).has(param),
  );
  if (!id && alias) {
    const [param, route] = alias;
    const number = new URLSearchParams(location.search).get(param)!;
    load<{ discord_id: string }>(
      `/accounts/${route}/${encodeURIComponent(number)}`,
    )
      .then(({ discord_id }) =>
        location.replace(page(`/urchin/members?id=${discord_id}`)),
      )
      .catch((error: Error) => {
        root.hidden = false;
        part("status").textContent = error.message;
      });
  }

  if (id) {
    root.hidden = false;
    document.getElementById("member-list")!.hidden = true;
    document.querySelector("main > .crumbs")!.setAttribute("hidden", "");
    show();
  }
</script>
