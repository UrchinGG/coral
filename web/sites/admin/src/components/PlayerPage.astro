---
import { page } from "@/lib/paths";
import SnapshotStyles from "@/components/SnapshotStyles.astro";
---

<SnapshotStyles />

<section id="player-page" class="member" hidden>
  <nav class="crumbs-nav" aria-label="Breadcrumb">
    <a href={page("/urchin/players")}>Players</a>
    <span aria-hidden="true">/</span>
    <span data-crumb></span>
  </nav>
  <header class="member-head">
    <div class="member-title">
      <h1 data-name>Loading…</h1>
      <div class="guild-line" data-guild></div>
      <div class="meta" data-meta></div>
      <div class="issues" data-issues></div>
    </div>
    <div class="actions" data-actions></div>
  </header>
  <div class="tabs" role="tablist" aria-label="Player sections" data-tabs></div>
  <p class="muted" data-status></p>
  <div data-tab></div>

  <dialog data-dialog="tag">
    <form method="dialog" class="dialog-form">
      <h2>Add Tag</h2>
      <label>
        Tag <select class="field" name="tag_type" data-tag-types></select>
      </label>
      <label>
        Reason <input class="field" name="reason" required />
      </label>
      <label class="check">
        <input type="checkbox" name="hide_username" /> Hide who added it
      </label>
      <div class="actions">
        <button class="button" value="cancel" formnovalidate>
          Cancel
        </button>
        <button class="button primary" value="confirm">
          Add Tag
        </button>
      </div>
    </form>
  </dialog>
  <dialog data-dialog="reason">
    <form method="dialog" class="dialog-form">
      <h2 data-reason-title></h2>
      <label>
        Reason <input class="field" name="reason" />
      </label>
      <div class="actions">
        <button class="button" value="cancel" formnovalidate>
          Cancel
        </button>
        <button class="button primary" value="confirm">
          Confirm
        </button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import { load, send } from "@/lib/api";
  import { el } from "@/lib/dom";
  import { FORMATS } from "@/lib/format";
  import { refLink } from "@/lib/refs";
  import { can, session, type Permission } from "@/lib/session";
  import { fillTab, setQuery, tabBar } from "@/lib/tabbar";
  import { tagPill } from "@/lib/tags";
  import {
    overviewTab,
    snapshotsTab,
    tagsTab,
    type PlayerCore,
    type Tag,
  } from "@/lib/tabs/player";
  import { lookupsTab } from "@/lib/tabs/player-lookups";
  import { ago, day } from "@/lib/time";

  const viewer = await session();
  const TABS: [string, string][] = [
    ["overview", "Overview"],
    ["tags", "Tag History"],
    ["snapshots", "Snapshots"],
    ["lookups", "Lookups"],
  ].filter(([key]) => key !== "lookups" || can(viewer, "traffic")) as [
    string,
    string,
  ][];

  const uuid = new URLSearchParams(location.search).get("uuid");
  const root = document.getElementById("player-page")!;
  const part = (name: string) =>
    root.querySelector<HTMLElement>(`[data-${name}]`)!;
  const dialog = (name: string) =>
    root.querySelector<HTMLDialogElement>(`[data-dialog="${name}"]`)!;
  let current = new URLSearchParams(location.search).get("tab") ?? "overview";
  let month = new URLSearchParams(location.search).get("month");

  function ask(name: string, then: (form: FormData) => void) {
    const box = dialog(name);
    box.querySelector("form")!.reset();
    box.showModal();
    box.addEventListener(
      "close",
      () =>
        box.returnValue === "confirm" &&
        then(new FormData(box.querySelector("form")!)),
      { once: true },
    );
  }

  async function act(path: string, method: string, body?: unknown) {
    const ok = await send(`/players/${uuid}${path}`, method, body);
    part("status").textContent = ok ? "" : "That didn't work; nothing changed.";
    if (ok) show();
  }

  const askReason = (title: string, path: string) => {
    part("reason-title").textContent = title;
    ask("reason", (form) =>
      act(path, "POST", { reason: String(form.get("reason") || "") || null }),
    );
  };

  function header(core: PlayerCore) {
    const name = core.name ?? core.dashed;
    document.title = `${name} | Urchin Admin`;
    part("crumb").textContent = name;
    part("name").textContent = name;
    part("guild").replaceChildren(...guildLine(core));
    part("meta").replaceChildren(
      ...core.blacklist.active.map((tag) =>
        tagPill(tag.tag_type, tag.display_name),
      ),
      ...meta(core).map((text, index) =>
        el("span", { className: index < 2 ? "mono" : "", textContent: text }),
      ),
    );
    const issues = [
      core.blacklist.locked &&
        `Locked: ${core.blacklist.locked.reason ?? "no reason"}`,
      core.minecraft_block &&
        `Sign-in blocked: ${core.minecraft_block.reason ?? "no reason"}`,
    ].filter(Boolean) as string[];
    part("issues").replaceChildren(
      ...issues.map((text) =>
        el("span", { className: "issue", textContent: text }),
      ),
    );
    const button = (
      label: string,
      needs: Permission,
      run: () => void,
      className = "button",
    ) => {
      if (!can(viewer, needs)) return [];
      const element = el("button", {
        type: "button",
        className,
        textContent: label,
      });
      element.addEventListener("click", run);
      return [element];
    };
    part("actions").replaceChildren(
      ...button("Add Tag", "tags_write", addTag),
      ...(core.blacklist.locked
        ? button("Unlock", "player_locks_write", () =>
            act("/unlock", "POST", {}),
          )
        : button("Lock", "player_locks_write", () =>
            askReason("Lock Tags", "/lock"),
          )),
      ...(core.minecraft_block
        ? button("Unblock Sign-in", "sign_in_blocks_write", () =>
            act("/unblock", "POST", {}),
          )
        : button(
            "Block Sign-in",
            "sign_in_blocks_write",
            () => askReason("Block Sign-in", "/block"),
            "button danger",
          )),
    );
  }

  function guildLine(core: PlayerCore) {
    const label = el("span", { className: "dim", textContent: "Guild" });
    const guild = core.guild;
    if (!guild)
      return [
        label,
        el("span", { className: "dim", textContent: "Not in a guild" }),
      ];
    const note = [
      guild.rank,
      guild.joined && `joined ${day(guild.joined)}`,
    ].filter(Boolean);
    return [
      label,
      refLink(guild.guild, core.labels),
      el("span", {
        className: "mono dim",
        textContent: guild.tag ? `[${guild.tag}]` : "",
      }),
      el("span", { className: "dim", textContent: note.join(", ") }),
    ];
  }

  function meta(core: PlayerCore) {
    const since = core.names.find((name) => name.current)?.first_seen;
    const { first, last, count } = core.snapshots;
    return [
      core.uuid,
      core.dashed,
      since && `Current name since ${day(since)}`,
      first && `First seen ${day(first)}`,
      last && `Last seen ${ago(last)}`,
      `${FORMATS.number(count)} ${count === 1 ? "snapshot" : "snapshots"}`,
    ].filter(Boolean) as string[];
  }

  async function addTag() {
    const { tag_types } = await load<{
      tag_types: { name: string; display_name: string }[];
    }>(`/players/${uuid}/tags`);
    part("tag-types").replaceChildren(
      ...tag_types.map((type) =>
        el("option", { value: type.name, textContent: type.display_name }),
      ),
    );
    ask("tag", (form) =>
      act("/tags", "POST", {
        tag_type: form.get("tag_type"),
        reason: form.get("reason"),
        hide_username: form.get("hide_username") === "on",
      }),
    );
  }

  const removeTag = (tag: Tag) =>
    confirm(`Remove ${tag.display_name}?`) &&
    act(`/tags/${encodeURIComponent(tag.tag_type)}`, "DELETE");

  function content(core: PlayerCore): Promise<Node> | Node {
    switch (current) {
      case "tags":
        return tagsTab(uuid!);
      case "snapshots":
        return snapshotsTab(core, month, (picked) =>
          go(core, "snapshots", picked),
        );
      case "lookups":
        return lookupsTab(core);
      default:
        return overviewTab(core, {
          removeTag: can(viewer, "tags_write") ? removeTag : undefined,
          lookups: can(viewer, "traffic"),
          open: (tab, picked) => go(core, tab, picked ?? null),
        });
    }
  }

  function go(core: PlayerCore, tab: string, picked: string | null = null) {
    current = tab;
    month = picked;
    setQuery("tab", tab === "overview" ? null : tab);
    setQuery("month", picked);
    render(core);
  }

  function render(core: PlayerCore) {
    tabBar(part("tabs"), TABS, current, (key) => go(core, key));
    fillTab(part("tab"), () => content(core));
  }

  async function show() {
    try {
      const core = await load<PlayerCore>(`/players/${uuid}`);
      header(core);
      render(core);
    } catch (error) {
      part("status").textContent = (error as Error).message;
    }
  }

  if (uuid) {
    root.hidden = false;
    document.getElementById("player-search")!.hidden = true;
    document.querySelector("main > .crumbs")!.setAttribute("hidden", "");
    show();
  }
</script>

<style>
  #player-page :global(.guild-line) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-size: var(--text-sm);
  }

  #player-page :global(.table-row.requesters) {
    grid-template-columns:
      minmax(120px, 1.4fr) 90px 72px 48px 60px 100px 80px
      minmax(140px, 1.4fr);
    min-width: 820px;
  }

  #player-page :global(button.table-row.requesters) {
    width: 100%;
    border: 0;
    border-top: 1px solid var(--color-divider);
    background: none;
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
  }

  #player-page :global(button.table-row.requesters:hover),
  #player-page :global(button.table-row.requesters[aria-pressed="true"]) {
    background: var(--color-surface-hover);
  }

  #player-page :global(.chip:disabled) {
    cursor: default;
  }

  #player-page :global(.warn-line) {
    margin: 0;
    color: var(--color-warning);
    font-size: var(--text-xs);
  }

  #player-page :global(.table .pad) {
    margin: 10px 14px;
  }
</style>
