<section id="plugin-list" class="list">
  <div data-stats></div>
  <div data-search></div>
  <div class="table" data-table></div>
</section>

<style is:global>
  #plugin-list .table-row.plugin {
    grid-template-columns:
      minmax(160px, 1.6fr) minmax(100px, 1fr)
      70px 80px 100px 80px 90px;
    min-width: 760px;
  }
</style>

<script>
  import { page } from "@/lib/paths";
  import { load } from "@/lib/api";
  import { el } from "@/lib/dom";
  import { filterBar, type FilterState, type Pick } from "@/lib/filterbar";
  import { FORMATS } from "@/lib/format";
  import type { Labels } from "@/lib/members";
  import { pager, type CursorPage } from "@/lib/pager";
  import { refText, type Ref } from "@/lib/refs";
  import { setQuery } from "@/lib/tabbar";

  interface PluginRow {
    plugin: { slug: string; name: string | null };
    owner: Ref | null;
    official: boolean;
    unlisted: boolean;
    disabled: boolean;
    latest_version: string | null;
    installs_30d: number;
    installs_total: number;
    rating_mean: number | null;
    rating_count: number;
  }

  interface Summary {
    listed: number;
    official: number;
    unlisted: number;
    disabled: number;
    installs_30d: number;
    owners: Ref[];
  }

  type Listing = CursorPage<PluginRow> & { summary: Summary | null };

  const STATES: Pick[] = [
    { value: "listed", label: "Listed" },
    { value: "official", label: "Official" },
    { value: "unlisted", label: "Unlisted" },
    { value: "disabled", label: "Disabled" },
  ];
  const root = document.getElementById("plugin-list")!;
  const part = (name: string) =>
    root.querySelector<HTMLElement>(`[data-${name}]`)!;
  const search: FilterState = {
    q: new URLSearchParams(location.search).get("q") ?? "",
    picks: {},
    range: null,
  };
  let owners: Pick[] = [];

  const state = (row: PluginRow) =>
    row.disabled
      ? ["Disabled", "bad"]
      : row.unlisted
        ? ["Unlisted", "warn"]
        : row.official
          ? ["Official", "ok"]
          : ["Listed", ""];

  const head = el(
    "div",
    { className: "table-row plugin head" },
    ...[
      "Plugin",
      "Owner",
      "Latest",
      "Installs",
      "Installs · 30 d",
      "Rating",
      "State",
    ].map((label) => el("span", { textContent: label })),
  );

  const render = (row: PluginRow, labels: Labels) => {
    const [label, className] = state(row);
    return el(
      "a",
      {
        className: "table-row plugin",
        href: page(`/starfish/plugins?slug=${row.plugin.slug}`),
      },
      el("span", {
        className: "strong",
        textContent: row.plugin.name ?? row.plugin.slug,
      }),
      refText(row.owner, labels),
      el("span", { className: "mono", textContent: row.latest_version ?? "" }),
      el("span", {
        className: "num",
        textContent: FORMATS.number(row.installs_total),
      }),
      el("span", {
        className: "num",
        textContent: FORMATS.number(row.installs_30d),
      }),
      el("span", {
        textContent:
          row.rating_mean === null
            ? ""
            : `${row.rating_mean.toFixed(1)} · ${row.rating_count}`,
      }),
      el("span", { className, textContent: label }),
    );
  };

  function stats(summary: Summary) {
    part("stats").replaceChildren(
      el(
        "div",
        { className: "stats" },
        ...[
          ["Listed", summary.listed],
          ["Official", summary.official],
          ["Unlisted", summary.unlisted],
          ["Disabled", summary.disabled],
          ["Installs · 30 d", summary.installs_30d],
        ].map(([label, value]) =>
          el(
            "div",
            { className: "stat" },
            el("span", { className: "label", textContent: String(label) }),
            el("b", { textContent: FORMATS.number(Number(value)) }),
          ),
        ),
      ),
    );
  }

  function ownerPicks(summary: Summary, labels: Labels) {
    return summary.owners.flatMap((owner) =>
      owner.kind === "account"
        ? [
            {
              value: owner.discord_id,
              label: labels.discord[owner.discord_id] ?? owner.discord_id,
            },
          ]
        : [],
    );
  }

  function listPath() {
    const params = new URLSearchParams();
    if (search.q) params.set("q", search.q);
    if (search.picks.state) params.set("state", search.picks.state.value);
    if (search.picks.owner) params.set("owner", search.picks.owner.value);
    return `/plugins${params.size ? `?${params}` : ""}`;
  }

  function refresh() {
    setQuery("q", search.q || null);
    const path = listPath();
    const fetchPage = async (cursor: string | null) => {
      const join = path.includes("?") ? "&" : "?";
      const listing = await load<Listing>(
        cursor ? `${path}${join}cursor=${encodeURIComponent(cursor)}` : path,
      );
      if (listing.summary) {
        stats(listing.summary);
        owners = ownerPicks(listing.summary, listing.labels);
      }
      return listing;
    };
    part("table").replaceChildren(
      head,
      pager<PluginRow>(fetchPage, render, "No plugin matches."),
    );
  }

  const bar = filterBar({
    placeholder: "Search plugins, owners, slugs and repos",
    hint: "Search names, descriptions, slugs, repos and owners, or pick a state or an owner",
    state: search,
    fields: [
      { key: "state", label: "State", values: () => STATES },
      { key: "owner", label: "Owner", values: () => owners },
    ],
    onChange: refresh,
  });
  part("search").append(bar.element);
  refresh();
</script>
