<section id="plugin-list" class="list">
  <form class="toolbar" role="search">
    <input
      class="field grow"
      type="search"
      name="q"
      placeholder="Search plugins, slugs, owners and repos"
      aria-label="Search plugins"
    />
  </form>
  <div class="table" data-table></div>
</section>

<script>
  import { page } from "@/lib/paths";
  import { el } from "@/lib/dom";
  import { FORMATS } from "@/lib/format";
  import type { Labels } from "@/lib/members";
  import { pager } from "@/lib/pager";
  import { refName, type Ref } from "@/lib/refs";
  import { setQuery } from "@/lib/tabbar";

  interface PluginRow {
    plugin: { slug: string; name: string | null };
    owner: Ref | null;
    official: boolean;
    unlisted: boolean;
    disabled: boolean;
    latest_version: string | null;
    installs_30d: number;
    installs_total: number;
    rating_mean: number | null;
    rating_count: number;
  }

  const SEARCH_DELAY_MS = 250;
  const root = document.getElementById("plugin-list")!;
  const input = root.querySelector("input")!;
  const table = root.querySelector<HTMLElement>("[data-table]")!;
  const state = (row: PluginRow) =>
    row.disabled
      ? ["Disabled", "bad"]
      : row.unlisted
        ? ["Unlisted", "warn"]
        : row.official
          ? ["Official", "ok"]
          : ["Listed", ""];

  const head = el(
    "div",
    { className: "table-row plugin head" },
    ...["Plugin", "Owner", "Latest", "Installs", "30 d", "Rating", "State"].map(
      (label) => el("span", { textContent: label }),
    ),
  );

  const render = (row: PluginRow, labels: Labels) => {
    const [label, className] = state(row);
    return el(
      "a",
      {
        className: "table-row plugin",
        href: page(`/starfish/plugins?slug=${row.plugin.slug}`),
      },
      el("span", {
        className: "strong",
        textContent: row.plugin.name ?? row.plugin.slug,
      }),
      el("span", { textContent: refName(row.owner, labels) }),
      el("span", { className: "mono", textContent: row.latest_version ?? "" }),
      el("span", {
        className: "num",
        textContent: FORMATS.number(row.installs_total),
      }),
      el("span", {
        className: "num",
        textContent: FORMATS.number(row.installs_30d),
      }),
      el("span", {
        textContent:
          row.rating_mean === null
            ? ""
            : `${row.rating_mean.toFixed(1)} · ${row.rating_count}`,
      }),
      el("span", { className, textContent: label }),
    );
  };

  function refresh() {
    const q = input.value.trim();
    setQuery("q", q || null);
    table.replaceChildren(
      head,
      pager<PluginRow>(
        `/plugins${q ? `?q=${encodeURIComponent(q)}` : ""}`,
        render,
        "No plugin matches.",
      ),
    );
  }

  input.value = new URLSearchParams(location.search).get("q") ?? "";
  let typing: ReturnType<typeof setTimeout>;
  input.addEventListener("input", () => {
    clearTimeout(typing);
    typing = setTimeout(refresh, SEARCH_DELAY_MS);
  });
  root
    .querySelector("form")!
    .addEventListener("submit", (event) => event.preventDefault());
  refresh();
</script>
