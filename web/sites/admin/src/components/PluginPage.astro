---
import { page } from "@/lib/paths";
---

<section id="plugin-page" class="member" hidden>
  <nav class="crumbs-nav" aria-label="Breadcrumb">
    <a href={page("/starfish/plugins")}>Plugins</a>
    <span aria-hidden="true">/</span>
    <span data-crumb></span>
  </nav>
  <header class="member-head">
    <div class="member-title">
      <h1 data-name>Loading…</h1>
      <p class="description" data-description></p>
      <div class="meta" data-meta></div>
      <div class="issues" data-issues></div>
    </div>
    <div class="actions" data-actions></div>
  </header>
  <p class="muted" data-status></p>
  <div class="stack" data-body></div>
</section>

<style is:global>
  #plugin-page {
    & .panel {
      max-width: 640px;
    }

    & .table-row.release {
      grid-template-columns: minmax(100px, 1fr) 120px 90px 90px 80px;
      width: 100%;
      min-width: 520px;
      border: 0;
      border-top: 1px solid var(--color-divider);
      background: none;
      font: inherit;
      font-size: var(--text-sm);
      text-align: left;
      cursor: pointer;

      &[aria-expanded="true"] {
        background: var(--color-surface-hover);
      }

      &.head {
        font-size: var(--text-2xs);
        cursor: default;
      }
    }

    & .table-row.review {
      grid-template-columns:
        minmax(110px, 1fr) 90px minmax(200px, 3fr)
        110px 80px;
      min-width: 640px;

      & > span:nth-child(3) {
        white-space: normal;
      }
    }

    & .stars {
      color: var(--color-warning);
      letter-spacing: 1px;
    }
  }
</style>

<script>
  import { page } from "@/lib/paths";
  import { load, send } from "@/lib/api";
  import { el, panel, problem, row } from "@/lib/dom";
  import { FORMATS } from "@/lib/format";
  import type { Labels } from "@/lib/members";
  import { refLink, type Ref } from "@/lib/refs";
  import { day } from "@/lib/time";

  interface Release {
    version: string;
    git_sha: string;
    asset_url: string;
    asset_sha256: string;
    asset_size: number;
    changelog: string | null;
    yanked: boolean;
    yanked_reason: string | null;
    created_at: string;
  }

  interface PluginDetail {
    plugin: {
      slug: string;
      display_name: string;
      description: string;
      repo: string;
      homepage: string | null;
      official: boolean;
      unlisted: boolean;
      disabled: boolean;
      disabled_reason: string | null;
      created_at: string;
      updated_at: string;
    };
    owner: Ref | null;
    owner_github: string | null;
    installs_30d: number;
    installs_total: number;
    releases: Release[];
    reviews: {
      user_id: number;
      reviewer: Ref | null;
      stars: number;
      review: string | null;
      updated_at: string;
    }[];
    labels: Labels;
  }

  const KILOBYTE = 1024;
  const SHORT_SHA = 7;
  const MAX_STARS = 5;
  const slug = new URLSearchParams(location.search).get("slug");
  const root = document.getElementById("plugin-page")!;
  const part = (name: string) =>
    root.querySelector<HTMLElement>(`[data-${name}]`)!;
  const path = `/plugins/${slug}`;

  async function act(suffix: string, method: string, body?: unknown) {
    const ok = await send(`${path}${suffix}`, method, body ?? {});
    part("status").textContent = ok ? "" : "That didn't work; nothing changed.";
    if (ok) show();
    return ok;
  }

  const button = (label: string, run: () => void, className = "button") => {
    const element = el("button", {
      type: "button",
      className,
      textContent: label,
    });
    element.addEventListener("click", run);
    return element;
  };

  function actions(info: PluginDetail["plugin"]) {
    return [
      button(info.official ? "Remove Official" : "Make Official", () =>
        act("/official", "POST", { official: !info.official }),
      ),
      button(info.unlisted ? "List" : "Unlist", () =>
        act("/unlisted", "POST", { unlisted: !info.unlisted }),
      ),
      button(
        info.disabled ? "Enable" : "Disable",
        () => {
          if (info.disabled)
            return act("/disabled", "POST", { disabled: false, reason: null });
          const reason = prompt(
            "Why disable this plugin? Members see the reason.",
          );
          if (reason !== null)
            act("/disabled", "POST", {
              disabled: true,
              reason: reason || null,
            });
        },
        "button danger",
      ),
      button(
        "Delete",
        async () => {
          if (
            prompt(
              `Type ${info.slug} to delete this plugin and every release.`,
            ) === info.slug &&
            (await send(path, "DELETE"))
          )
            location.href = page("/starfish/plugins");
        },
        "button danger",
      ),
    ];
  }

  function release(entry: Release) {
    const detail = el(
      "div",
      { className: "row-detail", hidden: true },
      row("Changelog", entry.changelog ?? "None"),
      row(
        "Git commit",
        el("span", { className: "mono", textContent: entry.git_sha }),
      ),
      row(
        "Asset SHA-256",
        el("span", { className: "mono", textContent: entry.asset_sha256 }),
      ),
      row(
        "Asset",
        el("a", {
          className: "ref",
          href: entry.asset_url,
          textContent: entry.asset_url.split("/").pop() ?? entry.asset_url,
        }),
      ),
      ...(entry.yanked_reason
        ? [row("Yanked because", entry.yanked_reason)]
        : []),
      el("div", { className: "actions" }, ...releaseActions(entry)),
    );
    const line = el(
      "button",
      { type: "button", className: "table-row release" },
      el("span", { className: "mono strong", textContent: entry.version }),
      el("span", { className: "dim", textContent: day(entry.created_at) }),
      el("span", {
        className: "num",
        textContent: `${FORMATS.number(Math.round(entry.asset_size / KILOBYTE))} KB`,
      }),
      el("span", {
        className: "mono dim",
        textContent: entry.git_sha.slice(0, SHORT_SHA),
      }),
      el("span", {
        className: entry.yanked ? "warn" : "ok",
        textContent: entry.yanked ? "Yanked" : "Active",
      }),
    );
    line.addEventListener("click", () => {
      detail.hidden = !detail.hidden;
      line.setAttribute("aria-expanded", String(!detail.hidden));
    });
    return el("div", {}, line, detail);
  }

  function releaseActions(entry: Release) {
    return [
      entry.yanked
        ? button(
            "Unyank",
            () => act(`/releases/${entry.version}/unyank`, "POST"),
            "button small",
          )
        : button(
            "Yank",
            () => {
              const reason = prompt(`Why yank ${entry.version}?`);
              if (reason !== null)
                act(`/releases/${entry.version}/yank`, "POST", {
                  reason: reason || null,
                });
            },
            "button small",
          ),
      button(
        "Delete Release",
        () =>
          confirm(`Delete ${entry.version}?`) &&
          act(`/releases/${entry.version}`, "DELETE"),
        "button small danger",
      ),
    ];
  }

  function review(entry: PluginDetail["reviews"][number], labels: Labels) {
    return el(
      "div",
      { className: "table-row review" },
      el("span", {}, entry.reviewer ? refLink(entry.reviewer, labels) : ""),
      el("span", {
        className: "stars",
        textContent: `${"★".repeat(entry.stars)}${"☆".repeat(MAX_STARS - entry.stars)}`,
      }),
      el("span", {
        className: entry.review ? "" : "dim",
        textContent: entry.review ?? "No text",
      }),
      el("span", { className: "dim", textContent: day(entry.updated_at) }),
      button(
        "Delete",
        () =>
          confirm("Delete this review?") &&
          act(`/reviews/${entry.user_id}`, "DELETE"),
        "button small danger",
      ),
    );
  }

  function table(
    title: string,
    className: string,
    columns: string[],
    rows: Node[],
    empty: string,
  ) {
    return el(
      "section",
      { className: "list" },
      el("h2", { className: "group-title", textContent: title }),
      rows.length
        ? el(
            "div",
            { className: "table" },
            el(
              "div",
              { className: `table-row ${className} head` },
              ...columns.map((label) => el("span", { textContent: label })),
            ),
            ...rows,
          )
        : el("p", { className: "muted", textContent: empty }),
    );
  }

  function stats(detail: PluginDetail) {
    const latest = detail.releases.find((entry) => !entry.yanked);
    const count = detail.reviews.length;
    const mean = count
      ? detail.reviews.reduce((sum, entry) => sum + entry.stars, 0) / count
      : null;
    return el(
      "div",
      { className: "stats" },
      ...[
        ["Latest", latest?.version ?? "None"],
        ["Installs", FORMATS.number(detail.installs_total)],
        ["Installs · 30 d", FORMATS.number(detail.installs_30d)],
        ["Rating", mean === null ? "None" : `${mean.toFixed(1)} from ${count}`],
        ["Releases", FORMATS.number(detail.releases.length)],
      ].map(([label, value]) =>
        el(
          "div",
          { className: "stat" },
          el("span", { className: "label", textContent: label }),
          el("b", { textContent: value }),
        ),
      ),
    );
  }

  function about(detail: PluginDetail) {
    const info = detail.plugin;
    return panel(
      "About",
      row(
        "Owner",
        detail.owner ? refLink(detail.owner, detail.labels) : "Unknown",
      ),
      row("GitHub", detail.owner_github ?? "Not linked"),
      row(
        "Repository",
        el("span", { className: "mono", textContent: info.repo }),
      ),
      row("Homepage", info.homepage ?? "None"),
    );
  }

  async function show() {
    try {
      const detail = await load<PluginDetail>(path);
      const info = detail.plugin;
      document.title = `${info.display_name} | Urchin Admin`;
      part("crumb").textContent = info.display_name;
      part("name").textContent = info.display_name;
      part("description").textContent = info.description;
      part("meta").replaceChildren(
        ...[
          info.slug,
          info.repo,
          `Created ${day(info.created_at)}`,
          `Updated ${day(info.updated_at)}`,
        ].map((text) => el("span", { textContent: text })),
      );
      part("issues").replaceChildren(
        ...[
          info.official && ["Official", "issue ok"],
          info.unlisted && ["Unlisted", "issue warn"],
          info.disabled && [
            `Disabled${info.disabled_reason ? `: ${info.disabled_reason}` : ""}`,
            "issue",
          ],
        ]
          .filter(Boolean)
          .map((entry) =>
            el("span", {
              className: (entry as string[])[1],
              textContent: (entry as string[])[0],
            }),
          ),
      );
      part("actions").replaceChildren(...actions(info));
      part("body").replaceChildren(
        stats(detail),
        about(detail),
        table(
          "Releases · click for details",
          "release",
          ["Version", "Released", "Size", "Commit", "State"],
          detail.releases.map(release),
          "No releases yet.",
        ),
        table(
          `Reviews · ${detail.reviews.length}`,
          "review",
          ["Member", "Stars", "Review", "Updated", ""],
          detail.reviews.map((entry) => review(entry, detail.labels)),
          "No reviews yet.",
        ),
      );
    } catch (error) {
      part("name").textContent = "Couldn't load this plugin";
      part("status").replaceChildren(
        problem((error as Error).message, () => location.reload()),
      );
    }
  }

  if (slug) {
    root.hidden = false;
    document.getElementById("plugin-list")!.hidden = true;
    document.querySelector("main > .crumbs")!.setAttribute("hidden", "");
    show();
  }
</script>
