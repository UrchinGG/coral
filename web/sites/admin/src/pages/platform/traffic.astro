---
import Admin from "@/layouts/Admin.astro";
---

<Admin title="Traffic">
  <div id="traffic" class="stack">
    <div
      class="seg window"
      role="group"
      aria-label="Time range"
      data-windows
    ></div>
    <div data-summary></div>
    <div data-series></div>
    <section class="list">
      <h2 class="group-title">
        Routes <span class="note">Click one to pick it</span>
      </h2>
      <div class="toolbar">
        <input
          class="field grow"
          type="search"
          placeholder="Search routes, like /v3/player or starfish"
          aria-label="Search routes"
          data-route-search
        />
      </div>
      <div data-routes></div>
    </section>
    <section class="list">
      <h2 class="group-title">
        Top Callers <span class="note">Click one to filter requests</span>
      </h2>
      <div data-callers></div>
    </section>
    <section class="list">
      <h2 class="group-title">Requests</h2>
      <div class="toolbar">
        <select class="field" aria-label="Route" data-route-pick>
          <option value="">All routes</option>
        </select>
        <select class="field" aria-label="Status" data-class>
          <option value="">Any status</option>
          <option value="2xx">2xx</option>
          <option value="4xx">4xx</option>
          <option value="rate_limited">Rate limited</option>
          <option value="5xx">5xx</option>
          <option value="error">Any error</option>
        </select>
        <input
          class="field"
          type="search"
          placeholder="IP address"
          aria-label="IP address"
          data-ip
        />
        <input
          class="field grow"
          type="search"
          placeholder="Search paths, players, errors"
          aria-label="Search requests"
          data-q
        />
      </div>
      <div class="chips" data-chips></div>
      <div data-requests></div>
    </section>
  </div>
</Admin>

<script>
  import { load } from "@/lib/api";
  import { el } from "@/lib/dom";
  import { fillTab } from "@/lib/tabbar";
  import {
    WINDOWS,
    callers,
    requests,
    routes,
    series,
    summary,
    UNMATCHED,
    pickedRoutes,
    type Filters,
  } from "@/lib/traffic";

  const SEARCH_DELAY_MS = 300;
  const root = document.getElementById("traffic")!;
  const part = <T extends HTMLElement = HTMLElement>(name: string) =>
    root.querySelector<T>(`[data-${name}]`)!;
  const url = new URLSearchParams(location.search);
  const filters: Filters = {
    window: url.get("window") ?? "24h",
    route: url.get("route"),
    method: url.get("method"),
    class: url.get("class"),
    member: url.get("member") ? Number(url.get("member")) : null,
    key_prefix: url.get("key_prefix"),
    requester: url.get("requester"),
    q: url.get("q") ?? "",
    ip: url.get("ip") ?? "",
  };

  function saveUrl() {
    const params = new URLSearchParams();
    for (const [key, value] of Object.entries(filters))
      if (
        value !== null &&
        value !== "" &&
        !(key === "window" && value === "24h")
      )
        params.set(key, String(value));
    history.replaceState(
      null,
      "",
      `${location.pathname}${params.size ? `?${params}` : ""}`,
    );
  }

  function chips() {
    const chip = (text: string, clear: () => void) => {
      const button = el("button", {
        type: "button",
        className: "chip",
        textContent: `${text} ×`,
      });
      button.addEventListener("click", () => {
        clear();
        refresh(true);
      });
      return button;
    };
    part("chips").replaceChildren(
      ...[
        filters.route
          ? chip(
              pickedRoutes(filters).length > 1
                ? `Routes: ${pickedRoutes(filters).join(", ")}`
                : `Route: ${filters.method ?? ""} ${filters.route}`,
              () => ((filters.route = null), (filters.method = null)),
            )
          : null,
        filters.requester
          ? chip(
              `Caller: ${filters.requester}`,
              () => (
                (filters.requester = null),
                (filters.member = null),
                (filters.key_prefix = null)
              ),
            )
          : null,
      ].filter((node): node is HTMLButtonElement => node !== null),
    );
    part<HTMLSelectElement>("route-pick").value =
      pickedRoutes(filters).length === 1
        ? `${filters.method ?? ""} ${filters.route}`
        : "";
  }

  function windows() {
    part("windows").replaceChildren(
      ...WINDOWS.map(([key, label]) => {
        const button = el("button", {
          type: "button",
          textContent: label,
          className: key === filters.window ? "on" : "",
        });
        button.addEventListener("click", () => {
          filters.window = key;
          refresh(false);
        });
        return button;
      }),
    );
  }

  const pickRoute = (route: { route: string | null; method: string }) => {
    const key = route.route ?? UNMATCHED;
    const picked = pickedRoutes(filters);
    const next = picked.includes(key)
      ? picked.filter((other) => other !== key)
      : [...picked, key];
    filters.route = next.length ? next.join(",") : null;
    filters.method = next.length === 1 ? route.method : null;
    refresh(true);
  };

  function refresh(filtersOnly: boolean) {
    saveUrl();
    windows();
    chips();
    if (!filtersOnly) fillTab(part("summary"), () => summary(filters));
    fillTab(part("series"), () => series(filters));
    fillTab(part("routes"), () =>
      routes(filters, part<HTMLInputElement>("route-search").value, pickRoute),
    );
    fillTab(part("callers"), () =>
      callers(filters, (caller, name) => {
        const same = filters.requester === name;
        filters.requester = same ? null : name;
        filters.member =
          !same && caller.requester.kind === "account"
            ? caller.requester.member_id
            : null;
        filters.key_prefix =
          !same && caller.requester.kind !== "account"
            ? caller.key_prefix
            : null;
        refresh(true);
      }),
    );
    part("requests").replaceChildren(requests(filters));
  }

  load<{ route: string; method: string | null; requests_24h: number }[]>(
    "/requests/routes",
  ).then((known) => {
    part("route-pick").append(
      ...known.map((entry) =>
        el("option", {
          value: `${entry.method ?? ""} ${entry.route}`,
          textContent: `${entry.method ?? "Any"} ${entry.route}`,
        }),
      ),
    );
    chips();
  });

  part<HTMLSelectElement>("route-pick").addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    const [method, route] = value
      ? [value.split(" ")[0] || null, value.split(" ").slice(1).join(" ")]
      : [null, null];
    filters.route = route;
    filters.method = method;
    refresh(true);
  });
  part<HTMLSelectElement>("class").value = filters.class ?? "";
  part<HTMLSelectElement>("class").addEventListener("change", (event) => {
    filters.class = (event.target as HTMLSelectElement).value || null;
    refresh(true);
  });
  let typing: ReturnType<typeof setTimeout>;
  for (const name of ["q", "ip"] as const) {
    const input = part<HTMLInputElement>(name);
    input.value = filters[name];
    input.addEventListener("input", () => {
      clearTimeout(typing);
      typing = setTimeout(() => {
        filters[name] = input.value.trim();
        saveUrl();
        part("requests").replaceChildren(requests(filters));
      }, SEARCH_DELAY_MS);
    });
  }
  part<HTMLInputElement>("route-search").addEventListener("input", () => {
    clearTimeout(typing);
    typing = setTimeout(
      () =>
        fillTab(part("routes"), () =>
          routes(
            filters,
            part<HTMLInputElement>("route-search").value,
            pickRoute,
          ),
        ),
      SEARCH_DELAY_MS,
    );
  });
  refresh(false);
</script>
