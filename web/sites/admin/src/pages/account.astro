---
import StarfishDownloads from "@shared/components/StarfishDownloads.astro";
import Admin from "@/layouts/Admin.astro";
import { page } from "@/lib/paths";
---

<Admin title="Account" crumbs={false}>
  <div class="account-page">
    <header class="identity" hidden>
      <div>
        <h1></h1>
        <p class="facts"></p>
      </div>
    </header>

    <section class="block" id="minecraft">
      <div class="block-head">
        <h2>Minecraft accounts</h2>
      </div>
      <ul class="accounts" role="list"></ul>
      <p class="hint">
        Link another account with <code>/link</code> in the Urchin Discord.
      </p>
    </section>

    <section class="block" id="starfish" hidden>
      <div class="block-head">
        <h2>
          <img
            src={page("/brand/starfish.svg")}
            alt=""
            width="20"
            height="17"
          />
          Starfish
        </h2>
        <p class="meta"></p>
      </div>
      <StarfishDownloads />
      <p class="hint changes"></p>
    </section>

    <section class="block key" id="activity" hidden>
      <div class="block-head">
        <h2>Activity</h2>
      </div>
    </section>

    <section class="block key" id="personal-key" hidden>
      <div class="block-head">
        <h2>API key</h2>
        <p class="meta"></p>
      </div>
    </section>

    <section class="block key" id="developer-key" hidden>
      <div class="block-head">
        <h2>Developer key</h2>
        <p class="meta"></p>
      </div>
    </section>
  </div>
</Admin>

<script>
  import { account } from "@shared/account";
  import { el } from "@/lib/dom";
  import { FORMATS } from "@/lib/format";
  import {
    activityChart,
    keyChart,
    sharedActivity,
    type KeyActivity,
  } from "@/lib/keychart";
  import { displayName, head, UNKNOWN_PLAYER } from "@/lib/minecraft";
  import { day } from "@/lib/time";

  interface Linked {
    uuid: string;
    name: string | null;
    prefix: string | null;
    primary: boolean;
  }

  interface ApiKey {
    key: string;
    permissions: string[] | null;
    used: number;
    limit: number;
    window_secs: number;
    total: number;
    created_at: string | null;
    locked: boolean;
  }

  interface Keys {
    personal: ApiKey | null;
    developer: ApiKey | null;
  }

  interface Member {
    member_id: number;
    joined_at: string;
  }

  interface RateLimit {
    used: number;
    limit: number;
    window_secs: number;
  }

  interface Activity extends KeyActivity {
    rate_limit: RateLimit;
  }

  interface Starfish {
    licensed: boolean;
    changes_left: number;
    version: string | null;
  }

  const NEAR_LIMIT = 0.85;
  const MASK = "•".repeat(32);

  const me = async <T,>(
    path: string,
    method = "GET",
  ): Promise<T | undefined> => {
    const response = await fetch(`/me/${path}`, { method }).catch(
      () => undefined,
    );
    return response?.ok ? response.json() : undefined;
  };

  function showIdentity(
    name: string,
    username: string,
    avatar: string,
    member?: Member,
  ) {
    const identity = document.querySelector<HTMLElement>(".identity")!;
    identity.prepend(
      el("img", {
        className: "avatar",
        src: avatar,
        alt: "",
        width: 56,
        height: 56,
      }),
    );
    identity.querySelector("h1")!.textContent = name;
    const facts = [`@${username}`];
    if (member)
      facts.push(
        `Member #${member.member_id}`,
        `Joined ${day(member.joined_at)}`,
      );
    identity
      .querySelector(".facts")!
      .replaceChildren(
        ...facts.map((fact) => el("span", { textContent: fact })),
      );
    identity.hidden = false;
  }

  function showMinecraft(accounts: Linked[]) {
    const rows = accounts.map((linked) =>
      el(
        "li",
        {},
        el("img", {
          src: head(linked.uuid, 32),
          alt: "",
          width: 32,
          height: 32,
        }),
        displayName(linked.prefix, linked.name ?? UNKNOWN_PLAYER),
        ...(linked.primary
          ? [el("span", { className: "tag", textContent: "Primary" })]
          : []),
      ),
    );
    document.querySelector("#minecraft .accounts")!.replaceChildren(...rows);
  }

  function showStarfish(starfish: Starfish) {
    const section = document.getElementById("starfish")!;
    section.querySelector(".meta")!.replaceChildren(
      el("span", { className: "licensed", textContent: "Licensed" }),
      ...(starfish.version
        ? [
            el("span", {
              className: "version",
              textContent: starfish.version,
            }),
          ]
        : []),
    );
    const plural = starfish.changes_left === 1 ? "change" : "changes";
    section.querySelector(".changes")!.textContent =
      `${starfish.changes_left} device ${plural} left this month.`;
    section.hidden = false;
  }

  function keyField(key: string) {
    const value = el("code", { textContent: MASK });
    const reveal = el("button", {
      type: "button",
      className: "button",
      textContent: "Show",
      onclick: () => {
        const hidden = value.textContent === MASK;
        value.textContent = hidden ? key : MASK;
        reveal.textContent = hidden ? "Hide" : "Show";
      },
    });
    const copy = el("button", {
      type: "button",
      className: "button",
      textContent: "Copy",
      onclick: () =>
        navigator.clipboard.writeText(key).then(() => {
          copy.textContent = "Copied";
          setTimeout(() => (copy.textContent = "Copy"), 1500);
        }),
    });
    return el("div", { className: "key-field" }, value, reveal, copy);
  }

  function usage(key: RateLimit) {
    const share = key.limit > 0 ? Math.min(key.used / key.limit, 1) : 0;
    const fill = el("span");
    fill.style.width = `${share * 100}%`;
    const meter = el("div", { className: "meter" }, fill);
    meter.classList.toggle("near", share >= NEAR_LIMIT);
    const minutes = Math.round(key.window_secs / 60);
    return el(
      "div",
      { className: "usage" },
      el(
        "div",
        { className: "usage-line" },
        el("span", { className: "dim", textContent: "Rate limit" }),
        el(
          "span",
          {},
          el("strong", { textContent: FORMATS.number(key.used) }),
          ` / ${FORMATS.number(key.limit)} per ${minutes} min`,
        ),
      ),
      meter,
    );
  }

  function regenerate(section: HTMLElement) {
    const button = el("button", {
      type: "button",
      className: "regenerate",
      textContent: "Regenerate key",
    });
    button.addEventListener("click", async () => {
      if (!button.dataset.sure) {
        button.dataset.sure = "";
        button.textContent = "Regenerate? Your old key stops working";
        return;
      }
      const key = await me<ApiKey>("keys/personal/regenerate", "POST");
      if (key) showKey(section, key, true);
    });
    return button;
  }

  function showKey(section: HTMLElement, key: ApiKey, personal: boolean) {
    const headRow = section.querySelector(".block-head")!;
    headRow
      .querySelector(".meta")!
      .replaceChildren(
        ...(key.locked
          ? [el("span", { className: "locked", textContent: "Locked" })]
          : []),
        ...(key.created_at ? [`Created ${day(key.created_at)}`] : []),
      );
    const permissions = key.permissions?.length
      ? [
          el(
            "div",
            { className: "usage-line" },
            el("span", { className: "dim", textContent: "Access" }),
            el("span", {
              textContent: new Intl.ListFormat("en").format(key.permissions),
            }),
          ),
        ]
      : [];
    section.replaceChildren(
      headRow,
      keyField(key.key),
      ...(personal
        ? []
        : [usage(key), ...permissions, keyChart("developer", activity)]),
      el(
        "div",
        { className: "key-foot" },
        el(
          "span",
          { className: "dim" },
          el("strong", { textContent: FORMATS.number(key.total) }),
          " requests all time",
        ),
        ...(personal ? [regenerate(section)] : []),
      ),
    );
    section.hidden = false;
  }

  function showActivity(rateLimit: RateLimit | undefined) {
    const section = document.getElementById("activity")!;
    section.append(
      ...(rateLimit ? [usage(rateLimit)] : []),
      activityChart(activity),
    );
    section.hidden = false;
  }

  const activity = sharedActivity((window) =>
    me<Activity>(`activity?window=${window}`),
  );

  const user = await account();
  if (user) {
    const [member, linked, keys, starfish] = await Promise.all([
      me<Member>("member"),
      me<Linked[]>("accounts"),
      me<Keys>("keys"),
      user.starfish_licensed ? me<Starfish>("starfish") : undefined,
    ]);
    showIdentity(user.name, user.username, user.avatar, member);
    showMinecraft(linked ?? []);
    if (starfish?.licensed) showStarfish(starfish);
    const recent = (await activity("24h")) as Activity | undefined;
    showActivity(recent?.rate_limit);
    if (keys?.personal)
      showKey(document.getElementById("personal-key")!, keys.personal, true);
    if (keys?.developer)
      showKey(document.getElementById("developer-key")!, keys.developer, false);
  }
</script>

<style>
  .account-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    max-width: 52rem;
  }

  .identity {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding-bottom: 0.25rem;

    & :global(.avatar) {
      flex: none;
      border-radius: 50%;
    }

    & h1 {
      color: var(--color-text-strong);
      font-size: var(--text-lg);
      font-weight: 600;
      line-height: 1.3;
    }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-panel);
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 1.75rem;

    & h2 {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      color: var(--color-text-strong);
      font-size: var(--text-base);
      font-weight: 600;

      & img {
        image-rendering: pixelated;
      }
    }
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);

    & code {
      padding: 0.1em 0.35em;
      border-radius: var(--radius-xs);
      background: var(--color-inset);
      color: var(--color-text-secondary);
      font-size: 0.9em;
    }
  }

  .accounts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.5rem;

    & :global(li) {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      min-width: 0;
      padding: 0.5rem 0.75rem 0.5rem 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }

    & :global(img) {
      flex: none;
      border-radius: var(--radius-xs);
      image-rendering: pixelated;
    }

    & :global(.mc-name) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    & :global(.tag) {
      margin-left: auto;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
    }
  }

  #starfish {
    & :global(.licensed) {
      display: inline-flex;
      gap: 0.375rem;
      align-items: center;
      color: var(--color-text-secondary);

      &::before {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-success);
        content: "";
      }
    }

    & :global(.version) {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
    }
  }

  .key :global(.key-field) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.375rem 0.375rem 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-inset);
  }

  .key :global(.key-field code) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .key :global(.key-field .button) {
    height: 1.875rem;
    padding-inline: 0.625rem;
    font-size: var(--text-xs);
  }

  .key :global(.usage-line) {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
  }

  .key :global(.meter) {
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-border);
  }

  .key :global(.meter span) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-info);
  }

  .key :global(.meter.near span) {
    background: var(--color-warning);
  }

  .key :global(.key-foot) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-divider);
    font-size: var(--text-sm);
  }

  .key :global(.key-foot strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .key :global(.regenerate) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-danger);
    font: inherit;
    cursor: pointer;
  }

  .key :global(.locked) {
    color: var(--color-warning);
  }

  .key :global(.dim) {
    color: var(--color-text-muted);
  }
</style>
