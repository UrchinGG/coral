---
import Admin from "@/layouts/Admin.astro";
import StatGroup from "@/components/StatGroup.astro";
---

<Admin title="Home">
  <div id="starfish-counts">
    <StatGroup
      stats={[
        { label: "Licensed", value: "licensed" },
        { label: "Signed In Now", value: "signed_in" },
      ]}
    />
  </div>
  <section id="licensed" class="list">
    <h2 class="group-title">Members</h2>
    <div data-search></div>
    <div class="table" data-table></div>
  </section>
</Admin>

<style is:global>
  #licensed .table-row.starfish {
    grid-template-columns:
      minmax(140px, 1.4fr) 90px 90px 80px minmax(90px, 1fr)
      100px;
    min-width: 640px;
  }
</style>

<script>
  import { page } from "@/lib/paths";
  import { load } from "@/lib/api";
  import { el } from "@/lib/dom";
  import { fill } from "@/lib/fill";
  import { filterBar, type FilterState, type Pick } from "@/lib/filterbar";
  import { titleCase } from "@/lib/format";
  import type { Labels } from "@/lib/members";
  import { pager } from "@/lib/pager";
  import { refText, type Ref } from "@/lib/refs";
  import { setQuery } from "@/lib/tabbar";
  import { ago } from "@/lib/time";

  interface StarfishUser {
    account: Ref & { discord_id: string };
    license_status: string;
    github_username: string | null;
    hwids: number;
    active_session: boolean;
    last_heartbeat_at: string | null;
  }

  const LICENSES: Pick[] = [
    { value: "active", label: "Active" },
    { value: "suspended", label: "Suspended" },
  ];
  const SESSIONS: Pick[] = [
    { value: "signed_in", label: "Signed in" },
    { value: "signed_out", label: "Signed out" },
  ];
  const root = document.getElementById("licensed")!;
  const table = root.querySelector<HTMLElement>("[data-table]")!;
  const search: FilterState = {
    q: new URLSearchParams(location.search).get("q") ?? "",
    picks: {},
    range: null,
  };

  load("/starfish/overview").then((counts) =>
    fill(document.getElementById("starfish-counts")!, counts),
  );

  const head = el(
    "div",
    { className: "table-row starfish head" },
    ...["Discord", "License", "Session", "Machines", "GitHub", "Last Seen"].map(
      (label) => el("span", { textContent: label }),
    ),
  );

  const render = (user: StarfishUser, labels: Labels) =>
    el(
      "a",
      {
        className: "table-row starfish",
        href: page(
          `/urchin/members?id=${user.account.discord_id}&tab=starfish`,
        ),
      },
      Object.assign(refText(user.account, labels), { className: "strong" }),
      el("span", {
        className: user.license_status === "active" ? "ok" : "bad",
        textContent: titleCase(user.license_status),
      }),
      el("span", {
        className: user.active_session ? "" : "dim",
        textContent: user.active_session ? "Signed in" : "Signed out",
      }),
      el("span", { className: "num", textContent: String(user.hwids) }),
      el("span", { className: "dim", textContent: user.github_username ?? "" }),
      el("span", {
        className: "dim",
        textContent: ago(user.last_heartbeat_at),
      }),
    );

  function refresh() {
    setQuery("q", search.q || null);
    const params = new URLSearchParams();
    if (search.q) params.set("q", search.q);
    if (search.picks.license) params.set("license", search.picks.license.value);
    if (search.picks.session) params.set("session", search.picks.session.value);
    table.replaceChildren(
      head,
      pager<StarfishUser>(
        `/starfish/users${params.size ? `?${params}` : ""}`,
        render,
        "No licensed member matches.",
      ),
    );
  }

  const bar = filterBar({
    placeholder: "Search Discord names and IDs, GitHub names, machine IDs",
    hint: "Search names, IDs and machine IDs, or pick a license or session state",
    state: search,
    fields: [
      { key: "license", label: "License", values: () => LICENSES },
      { key: "session", label: "Session", values: () => SESSIONS },
    ],
    onChange: refresh,
  });
  root.querySelector("[data-search]")!.append(bar.element);
  refresh();
</script>
