---
import Head from "@shared/components/Head.astro";
import Header from "@shared/components/Header.astro";
import { ACCOUNT, SECTIONS, sectionOf } from "@/lib/nav";
import { page, pagePath } from "@/lib/paths";
import "@shared/styles/global.css";
import "@shared/styles/controls.css";
import "@/styles/admin.css";

interface Props {
  title: string;
  crumbs?: boolean;
}

const { title, crumbs = true } = Astro.props;
const path = pagePath(Astro.url.pathname.replace(/\.html$/, ""));
const section = sectionOf(path);
const current = (target: string) => (target === path ? "page" : undefined);
---

<html lang="en">
  <Head
    siteName="Urchin"
    logo={page("/brand/urchin.svg")}
    title={title}
    description="Your Urchin dashboard"
  />
  <body>
    <Header site="urchin">
      <input
        class="search"
        type="search"
        placeholder="Search member, player, UUID, guild…"
        aria-label="Search"
        hidden
      />
    </Header>
    <div class="shell">
      <nav class="rail" aria-label="Dashboard" hidden>
        <div class="group">
          <a href={page(ACCOUNT.path)} aria-current={current(ACCOUNT.path)}>
            {ACCOUNT.title}
          </a>
        </div>
        {SECTIONS.map((group) => (
          <div class="group section" hidden>
            <span class="label">{group.name}</span>
            {group.pages.map((entry) => (
              <a
                href={page(entry.path)}
                data-needs={entry.needs}
                aria-current={current(entry.path)}
                hidden
              >
                {entry.title}
              </a>
            ))}
          </div>
        ))}
      </nav>
      <main id="content">
        {crumbs && (
          <h1 class="crumbs">
            {section ? `${section.name} / ` : ""}
            {title}
          </h1>
        )}
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import { watchNames } from "@/lib/names";
  import { omnibox } from "@/lib/omnibox";
  import { can, session, type Permission } from "@/lib/session";

  const rail = document.querySelector<HTMLElement>(".rail")!;
  const search = document.querySelector<HTMLInputElement>(".search")!;

  const viewer = await session();
  for (const link of rail.querySelectorAll<HTMLElement>("[data-needs]"))
    link.hidden = !can(viewer, link.dataset.needs as Permission);
  for (const group of rail.querySelectorAll<HTMLElement>(".group[hidden]"))
    group.hidden = !group.querySelector("a:not([hidden])");
  rail.hidden = !rail.querySelector(".section:not([hidden])");
  if (can(viewer, "staff")) {
    search.hidden = false;
    omnibox(search);
    watchNames(document.getElementById("content")!);
  }
</script>
