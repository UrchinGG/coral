---
import Head from "@shared/components/Head.astro";
import { SECTIONS, sectionOf } from "@/lib/nav";
import "@shared/styles/global.css";
import "@shared/styles/controls.css";
import "@/styles/admin.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "");
const section = sectionOf(path);
---

<html lang="en">
  <Head
    siteName="Urchin Admin"
    logo="/brand/urchin.svg"
    title={title}
    description="Urchin staff dashboard"
  />
  <body>
    <header class="topbar">
      <button
        type="button"
        class="menu"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
      <a class="brand" href="/urchin" aria-label="Urchin">
        <img src="/brand/urchin.svg" alt="" width="22" height="22" />
        <span>Urchin</span>
      </a>
      <input
        class="search"
        type="search"
        placeholder="Search member, player, UUID, guild…"
        aria-label="Search"
      />
      <span class="who" id="who"></span>
    </header>
    <div class="backdrop" hidden></div>
    <nav id="drawer" class="drawer" aria-label="Sections">
      {SECTIONS.map((group) => (
        <div class="group">
          <span class="label">{group.name}</span>
          {group.pages.map((page) => (
            <a
              href={page.path}
              aria-current={page.path === path ? "page" : undefined}
            >
              {page.title}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <main id="content">
      <h1 class="crumbs">
        {section ? `${section.name} / ` : ""}
        {title}
      </h1>
      <slot />
    </main>
  </body>
</html>

<script>
  import { session } from "@/lib/session";

  const menu = document.querySelector<HTMLButtonElement>(".menu")!;
  const drawer = document.getElementById("drawer")!;
  const backdrop = document.querySelector<HTMLElement>(".backdrop")!;

  const setOpen = (open: boolean) => {
    menu.setAttribute("aria-expanded", String(open));
    drawer.classList.toggle("open", open);
    backdrop.hidden = !open;
  };

  menu.addEventListener("click", () =>
    setOpen(menu.getAttribute("aria-expanded") !== "true"),
  );
  backdrop.addEventListener("click", () => setOpen(false));
  document.addEventListener(
    "keydown",
    (event) => event.key === "Escape" && setOpen(false),
  );

  const me = await session();
  if (me) document.getElementById("who")!.textContent = me.discord_id;
</script>
