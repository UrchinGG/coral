---
import DocsShell from "@shared/components/DocsShell.astro";
import { docGroups } from "@/lib/starfish";
import { page } from "@/lib/paths";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  heading: string;
  summary: string;
}

const { title, heading, summary } = Astro.props;

const groups = docGroups.map(({ group, pages }, index) => ({
  label: group,
  items: [
    ...(index === 0
      ? [
          { title: "Introduction", href: page("/docs") },
          { title: "Publishing", href: page("/docs/publishing") },
        ]
      : []),
    ...pages.map((entry) => ({
      title: entry.title,
      href: page(`/docs/${entry.slug}`),
    })),
  ],
}));
---

<Layout title={title} description={summary}>
  <DocsShell
    name="Starfish"
    logo="/brand/starfish.svg"
    groups={groups}
    heading={heading}
    summary={summary}
  >
    <slot />
  </DocsShell>
</Layout>
