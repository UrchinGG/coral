---
import { marked } from "marked";
import Container from "@shared/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { releases } from "@/lib/starfish";

const date = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<Layout
  title="Starfish Patch Notes"
  description="Patch notes and changelogs for Starfish."
>
  <Container width="narrow" class="patch-notes">
    <h1>
      <img src="/brand/starfish.svg" alt="" width="28" height="28" />
      Starfish Patch Notes
    </h1>
    <ol role="list">
      {releases.map(({ published_at, release_notes }) => (
        <li>
          <time datetime={published_at}>
            {date.format(new Date(published_at))}
          </time>
          {release_notes && (
            <div
              class="notes"
              set:html={marked.parse(release_notes, { async: false })}
            />
          )}
        </li>
      ))}
    </ol>
  </Container>
</Layout>

<style>
  .patch-notes {
    padding-block: 3rem 4rem;
  }

  h1 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    font-size: var(--text-2xl);
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-left: 1px solid var(--color-border);
  }

  li {
    padding-left: 2rem;
  }

  time {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  .notes {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .notes :global(:is(h1, h2, h3, h4)) {
    margin-block: 1rem 0.375rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .notes :global(:first-child) {
    margin-top: 0;
  }

  .notes :global(:is(p, ul, ol)) {
    margin-bottom: 0.5rem;
  }

  .notes :global(:is(ul, ol)) {
    padding-left: 1.25rem;
  }

  .notes :global(li + li) {
    margin-top: 0.25rem;
  }

  .notes :global(strong) {
    color: var(--color-text-secondary);
  }

  .notes :global(a) {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
