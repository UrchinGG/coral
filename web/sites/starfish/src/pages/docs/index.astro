---
import Card from "@shared/components/Card.astro";
import DocSection from "@/components/DocSection.astro";
import Prose from "@/components/Prose.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { docGroups, docs } from "@/lib/starfish";
---

<DocsLayout
  title="Starfish Plugin API"
  heading="Plugin API"
  summary="Lua scripting reference for Starfish plugins."
>
  <section>
    <h2>Start here</h2>
    <p>
      <Prose text={docs.introduction} />
    </p>
    <p>
      <Prose text={docs.templateReference} />
    </p>
    <pre><code>{docs.template.trimEnd()}</code></pre>
  </section>

  <DocSection section={docs.sharedTypes} />

  <section>
    <h2>Reference</h2>
    {docGroups.map(({ group, pages }) => (
      <div class="group">
        <h3 class="label">{group}</h3>
        {pages.map((page) => (
          <Card title={page.title} href={`/docs/${page.slug}`} level={4}>
            {page.summary}
          </Card>
        ))}
      </div>
    ))}
  </section>

  <section>
    <h2>For AI agents</h2>
    <p>
      The whole API as one plain-text file, for pasting into an LLM:{" "}
      <a href="/llms.txt">llms.txt</a>
    </p>
  </section>
</DocsLayout>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    & + .group {
      margin-top: 1.5rem;
    }
  }
</style>
