---
import Wordmark from "@shared/components/Wordmark.astro";

const icons = {
  tray: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 15h18" />',
  minimize: '<path d="M4.8 11.2h14.4" stroke-width="1.6" />',
  close: '<path d="m4.8 4.8 14.4 14.4M19.2 4.8 4.8 19.2" stroke-width="1.6" />',
  menu: '<path d="M4 5h16M4 12h16M4 19h16" />',
  processes:
    '<rect x="2" y="4" width="20" height="16" rx="2" /><path d="M10 4v4M2 8h20M6 4v4" />',
  plugins:
    '<path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" />',
  logs: '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2zM14 2v5a1 1 0 0 0 1 1h5M10 9H8M16 13H8M16 17H8" />',
  settings:
    '<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" />',
  chevron: '<path d="m6 9 6 6 6-6" />',
};

const tabs = [icons.processes, icons.plugins, icons.logs, icons.settings];

const instances = [
  {
    title: "Minecraft 1.8.9",
    pid: 57528,
    icon: "oneclient",
    injected: true,
    launcher: "OneClient",
    loader: "Fabric",
    autoInject: true,
  },
  {
    title: "Lunar Client 1.8.9 (v2.23.11-2644)",
    pid: 69396,
    icon: "lunar",
    injected: false,
    launcher: "Lunar Client",
    autoInject: false,
  },
];

const autoInjectCount = instances.filter(
  (instance) => instance.autoInject,
).length;
---

<figure class="showcase" aria-label="The Starfish app, injected into Minecraft">
  <div class="window" aria-hidden="true">
    <div class="titlebar">
      <Wordmark />
      <span class="controls">
        {[icons.tray, icons.minimize, icons.close].map((icon) => (
          <svg viewBox="0 0 24 24" set:html={icon} />
        ))}
      </span>
    </div>
    <div class="rail">
      <span class="nav">
        <svg viewBox="0 0 24 24" set:html={icons.menu} />
      </span>
      <span class="divider"></span>
      {tabs.map((icon, index) => (
        <span class:list={["nav", { active: index === 0 }]}>
          <svg viewBox="0 0 24 24" set:html={icon} />
        </span>
      ))}
    </div>
    <div class="main">
      <div class="header">
        Processes
        <span class="menu">
          Auto-Inject
          <span class="count">{autoInjectCount}</span>
          <svg viewBox="0 0 24 24" set:html={icons.chevron} />
        </span>
      </div>
      <div class="content">
        {instances.map(
          ({ title, pid, icon, injected, launcher, loader, autoInject }) => (
            <div class="card">
              <div class="instance">
                <span class="tile">
                  <img
                    src={`/clients/${icon}.png`}
                    alt=""
                    width="24"
                    height="24"
                  />
                </span>
                <span class="body">
                  <span class="title">{title}</span>
                  <span class="meta">
                    PID {pid}
                    <span class:list={["state", { live: injected }]}>
                      <span class="dot"></span>
                      {injected ? "Injected" : "Idle"}
                    </span>
                  </span>
                </span>
                <span class:list={["action", { success: !injected }]}>
                  {injected ? "Unload" : "Inject"}
                </span>
              </div>
              <div class="client">
                {launcher}
                {loader && <span class="badge">{loader}</span>}
                <span class="auto">
                  Auto-Inject
                  <span class:list={["toggle", { on: autoInject }]}></span>
                </span>
              </div>
            </div>
          ),
        )}
      </div>
    </div>
    <div class="status">
      <span class="dot"></span>Injected into Minecraft 1.8.9
    </div>
  </div>
</figure>

<style>
  .showcase {
    width: 550px;

    @media (width < 600px) {
      zoom: 0.6;
    }
  }

  .window {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    grid-template-rows: 32px minmax(0, 1fr) 22px;
    height: 450px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-background);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.5);
    font-size: 12px;
    line-height: 1.618;
    pointer-events: none;
    user-select: none;
  }

  svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .titlebar {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    padding-left: 14px;
    border-bottom: 1px solid var(--color-divider);
  }

  .controls {
    display: flex;
    align-self: stretch;
    margin-left: auto;
    color: var(--color-text-muted);

    & svg {
      width: 40px;
      height: 16px;
      align-self: center;
    }
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-block: 8px;
    border-right: 1px solid var(--color-divider);
  }

  .nav {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);

    & svg {
      width: 18px;
      height: 18px;
    }
  }

  .nav.active {
    background: var(--color-border);
    color: var(--color-text-strong);
  }

  .divider {
    width: 20px;
    height: 1px;
    margin-block: 2px;
    background: var(--color-divider);
  }

  .main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .header {
    display: flex;
    flex: none;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-text-strong);
    font-size: 13px;
    font-weight: 600;
  }

  .menu,
  .action {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
  }

  .menu {
    height: 28px;
    margin-left: auto;
    padding: 0 10px;

    & svg {
      width: 14px;
      height: 14px;
    }
  }

  .count {
    display: grid;
    place-items: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-success-fill);
    color: var(--color-success);
    font-size: 10px;
    font-weight: 600;
  }

  .content {
    display: grid;
    gap: 12px;
    padding: 12px 16px;
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .instance {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 18px 18px 16px;
  }

  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-inset);
  }

  .body {
    display: grid;
    flex: 1;
    gap: 3px;
    min-width: 0;
  }

  .title {
    overflow: hidden;
    color: var(--color-text-strong);
    font-size: 16px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-secondary);
  }

  .state {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-faint);
    font-size: 11px;
  }

  .state.live {
    color: var(--color-success);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .action {
    height: 32px;
    padding: 0 14px;
  }

  .action.success {
    border-color: var(--color-success-border);
    background: var(--color-success-fill);
    color: var(--color-success);
  }

  .client {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 18px;
    border-top: 1px solid var(--color-divider);
    background: var(--color-background);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .badge {
    display: flex;
    align-items: center;
    height: 17px;
    padding: 0 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: 10px;
  }

  .auto {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .toggle {
    position: relative;
    width: 28px;
    height: 16px;
    border: 1px solid var(--color-border-hover);
    border-radius: 999px;
    background: var(--color-inset);

    &::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--color-text-faint);
    }
  }

  .toggle.on {
    border-color: var(--color-success-border);
    background: var(--color-success-fill);

    &::after {
      left: 14px;
      background: var(--color-success);
    }
  }

  .status {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border-top: 1px solid var(--color-divider);
    color: var(--color-text-muted);
    font-size: 11px;

    & .dot {
      background: var(--color-success);
    }
  }
</style>
