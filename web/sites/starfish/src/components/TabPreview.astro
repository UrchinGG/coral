---
import Legacy from "@shared/components/Legacy.astro";
import type { tabList } from "@/data/showcase";

type Props = typeof tabList & { label: string };

const { title, rows, label } = Astro.props;
const SEPARATOR = "§8|";
---

<figure class="tab" aria-label={label}>
  <Legacy text={title} />
  <div class="table">
    <div class="row">
      <Legacy text="§7✫" class="star" />
      <Legacy text={SEPARATOR} />
      <Legacy text="§7Name" />
      <Legacy text={SEPARATOR} />
      <Legacy text="§7FKDR" />
      <Legacy text={SEPARATOR} />
      <Legacy text="§7Finals" />
    </div>
    {rows.map(({ skin, team, badge, star, name, fkdr, finals }) => (
      <div class="row entry">
        <span class="head" style={`--skin: url(/skins/${skin}.png)`} />
        <Legacy text={`${team} ${badge}`} />
        <Legacy text={star} class="star" />
        <Legacy text={SEPARATOR} />
        <Legacy text={name} />
        <Legacy text={SEPARATOR} />
        <Legacy text={fkdr} />
        <Legacy text={SEPARATOR} />
        <Legacy text={finals} />
        <svg class="ping" viewBox="0 0 10 8" aria-hidden="true">
          {[2, 3, 4, 5, 6].map((height, index) => (
            <rect x={index * 2} y={7 - height} width="1" height={height} />
          ))}
        </svg>
      </div>
    ))}
  </div>
</figure>

<style>
  .tab {
    display: grid;
    justify-items: center;
    width: max-content;
    padding: 2px;
    background: var(--mc-tab);
    font-size: 18px;
    line-height: 18px;
  }

  .table {
    display: grid;
    grid-template-columns: 16px repeat(8, auto) 20px;
    gap: 2px 8px;
    padding-block: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    height: 16px;
    padding-right: 2px;
    line-height: 16px;

    & > :global(.star) {
      grid-column: 3;
      justify-self: end;
    }
  }

  .entry {
    background: var(--mc-tab-row);
  }

  .head {
    height: 16px;
    background-image: var(--skin), var(--skin);
    background-position:
      -80px -16px,
      -16px -16px;
    background-size: 128px;
    image-rendering: pixelated;
  }

  .ping {
    width: 20px;
    height: 16px;
    fill: #3ce03c;
  }
</style>
